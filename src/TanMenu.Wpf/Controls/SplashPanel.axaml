<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:TanMenu.Wpf.Controls"
             x:Class="TanMenu.Wpf.Controls.SplashPanel">

  <!--
    The startup splash, and (with ShowLoading=false) the "关于" panel.

    Deliberately NOT the Windows 2000 theme: this is the product's own brand surface and it looked
    exactly like this in the shipping build (a blue gradient card with the logo, the spinner and the
    footer). Porting it verbatim keeps the app's identity; the retro chrome is the launcher, not the
    about box.

    Everything binds through $parent[ctl:SplashPanel] rather than the DataContext, so the control is
    driven purely by its own properties and inherits nothing from whoever hosts it.
  -->

  <UserControl.Styles>
    <!-- The animations are gated on a CLASS rather than IsVisible: a hidden control stays attached to
         the visual tree, and an infinite animation on it would keep ticking for the whole
         tray-resident session. The class is off whenever this isn't the active loading splash. -->
    <Style Selector="Path.tm-spinner.spinning">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0.0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360.0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.tm-dot">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <!-- Three dots, same 1.4s blink, staggered 0 / 0.2 / 0.4s. Avalonia has no per-keyframe delay, so
         each stagger has to be its own animation. -->
    <Style Selector="TextBlock.tm-dot.blinking.d1">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.tm-dot.blinking.d2">
      <Style.Animations>
        <Animation Duration="0:0:1.4" Delay="0:0:0.2" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.tm-dot.blinking.d3">
      <Style.Animations>
        <Animation Duration="0:0:1.4" Delay="0:0:0.4" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <!-- Avalonia puts the text properties on TextElement as ATTACHED properties; a plain Border or
       Panel has no FontFamily of its own, but the attached one still inherits down the tree. -->
  <!-- The card is accent-coloured, and the accent is the USER's: AppTheme publishes AccentColor and
       AccentColorShaded from Windows personalization at startup, so the splash and the launcher's
       highlights are the same blue (or pink, or green) rather than a hardcoded one. -->
  <Border Padding="24,20" ClipToBounds="True"
          TextElement.FontFamily="{DynamicResource AppFontFamily}">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
        <GradientStop Offset="1" Color="{DynamicResource AccentColorShaded}" />
      </LinearGradientBrush>
    </Border.Background>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">

      <!-- 60×60 white rounded plate holding the 46×46 app icon. -->
      <Border Width="60" Height="60" CornerRadius="12" Background="White"
              Margin="0,0,0,14" HorizontalAlignment="Center" ClipToBounds="True"
              BoxShadow="0 8 32 0 #2E000000">
        <Image Source="avares://TanMenu.Wpf/wwwroot/app-tile.png"
               Width="46" Height="46" Stretch="Uniform" />
      </Border>

      <TextBlock Text="TanMenu" Foreground="White" FontSize="28" FontWeight="Light"
                 HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Text="by TanSoft" Foreground="White" FontSize="14" FontWeight="Light"
                 Opacity="0.85" HorizontalAlignment="Center" Margin="0,0,0,16" />

      <!-- Startup: spinner + blinking dots. -->
      <StackPanel IsVisible="{Binding $parent[ctl:SplashPanel].ShowLoading}" Margin="0,0,0,14">
        <Panel Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Ellipse Width="40" Height="40" Stroke="#33FFFFFF" StrokeThickness="3" />
          <!-- A quarter arc drawn as an explicit path: no dependency on a shape whose API has moved
               between Avalonia versions, and it stays crisp at every DPI. -->
          <Path Classes="tm-spinner"
                Classes.spinning="{Binding $parent[ctl:SplashPanel].ShowLoading}"
                Width="40" Height="40" Stretch="None"
                Stroke="White" StrokeThickness="3" StrokeLineCap="Round"
                RenderTransformOrigin="50%,50%"
                Data="M 20,1.5 A 18.5,18.5 0 0 1 38.5,20" />
        </Panel>
        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
          <TextBlock Classes="tm-dot d1"
                     Classes.blinking="{Binding $parent[ctl:SplashPanel].ShowLoading}" Text="●" />
          <TextBlock Classes="tm-dot d2"
                     Classes.blinking="{Binding $parent[ctl:SplashPanel].ShowLoading}" Text="●" />
          <TextBlock Classes="tm-dot d3"
                     Classes.blinking="{Binding $parent[ctl:SplashPanel].ShowLoading}" Text="●" />
        </StackPanel>
      </StackPanel>

      <!-- About: "click anywhere to close" instead of the spinner. -->
      <TextBlock IsVisible="{Binding $parent[ctl:SplashPanel].ShowHint}"
                 Text="{Binding $parent[ctl:SplashPanel].HintText}"
                 Foreground="White" FontSize="13" Opacity="0.7"
                 HorizontalAlignment="Center" Margin="0,0,0,14" />

      <!-- In flow, not absolute: the window is content-sized, so an absolute footer would overlap. -->
      <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center">
        <TextBlock Text="{Binding $parent[ctl:SplashPanel].VersionText}"
                   Foreground="White" FontSize="12" Opacity="0.6"
                   HorizontalAlignment="Center" Margin="0,0,0,4" />
        <TextBlock Text="{Binding $parent[ctl:SplashPanel].CopyrightText}"
                   Foreground="White" FontSize="11" Opacity="0.5"
                   HorizontalAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>
