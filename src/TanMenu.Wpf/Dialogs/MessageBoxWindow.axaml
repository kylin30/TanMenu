<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TanMenu.Wpf.Dialogs.MessageBoxWindow"
        Title="TanMenu"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        MinWidth="300">

  <!--
    Deliberately styled by the DEFAULT Fluent theme, not by Themes/Retro.axaml. The retro chrome is
    the launcher's identity; a Windows 2000 alert box in front of a modern Windows would read as a
    rendering fault rather than as period detail. Nothing here carries a retro- or tm- class, so the
    theme cannot reach it.

    Buttons are created in code-behind: their count, order, labels (localized) and default/cancel
    roles all depend on the MessageBoxButtons value.
  -->
  <StackPanel Margin="22,20">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <Border Name="IconHost"
              Width="30" Height="30"
              CornerRadius="15"
              IsVisible="False"
              VerticalAlignment="Top">
        <TextBlock Name="IconGlyph"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="17"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <TextBlock Name="MessageText"
                 MaxWidth="420"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Name="ButtonRow"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,22,0,0"
                HorizontalAlignment="Right" />
  </StackPanel>

</Window>
