<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:settings="using:TanMenu.Wpf.Views.Settings"
             x:Class="TanMenu.Wpf.Views.SettingsPage">
  <Grid Margin="24" ColumnDefinitions="184,1,*" ColumnSpacing="24">
    <Border Grid.Column="0" Classes="hero-settings-section-nav">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="12,8,12,18" Spacing="4">
          <TextBlock x:Name="SettingsTitle"
                     Classes="hero-section-title" />
          <TextBlock x:Name="SettingsSubtitle"
                     Classes="hero-page-subtitle"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
          <Button x:Name="AppearanceNavButton"
                  Classes="hero-button hero-settings-nav-item is-active"
                  Tag="0"
                  Click="OnSectionClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ui:FASymbolIcon Symbol="View" FontSize="16" />
              <TextBlock x:Name="AppearanceNavLabel" />
            </StackPanel>
          </Button>
          <Button x:Name="BehaviorNavButton"
                  Classes="hero-button hero-settings-nav-item"
                  Tag="1"
                  Click="OnSectionClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ui:FASymbolIcon Symbol="BackToWindow" FontSize="16" />
              <TextBlock x:Name="BehaviorNavLabel" />
            </StackPanel>
          </Button>
          <Button x:Name="FoldersNavButton"
                  Classes="hero-button hero-settings-nav-item"
                  Tag="2"
                  Click="OnSectionClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ui:FASymbolIcon Symbol="Folder" FontSize="16" />
              <TextBlock x:Name="FoldersNavLabel" />
            </StackPanel>
          </Button>
          <Button x:Name="ToolsNavButton"
                  Classes="hero-button hero-settings-nav-item"
                  Tag="3"
                  Click="OnSectionClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ui:FASymbolIcon Symbol="Bullets" FontSize="16" />
              <TextBlock x:Name="ToolsNavLabel" />
            </StackPanel>
          </Button>
          <Button x:Name="UpdatesNavButton"
                  Classes="hero-button hero-settings-nav-item"
                  Tag="4"
                  Click="OnSectionClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ui:FASymbolIcon Symbol="Sync" FontSize="16" />
              <TextBlock x:Name="UpdatesNavLabel" />
            </StackPanel>
          </Button>
          <Button x:Name="AboutNavButton"
                  Classes="hero-button hero-settings-nav-item"
                  Tag="5"
                  Click="OnSectionClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="i"
                         Width="16"
                         FontSize="16"
                         FontWeight="Bold"
                         TextAlignment="Center" />
              <TextBlock x:Name="AboutNavLabel" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource Hero.SeparatorBrush}" />

    <ScrollViewer Grid.Column="2"
                  x:Name="SettingsScroll"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Width="{Binding #SettingsScroll.Viewport.Width}"
                  MaxWidth="1000"
                  HorizontalAlignment="Left"
                  Spacing="36">
        <StackPanel x:Name="AppearanceSection" Spacing="16">
          <TextBlock x:Name="AppearanceSectionHeading"
                     Classes="hero-page-title" />
          <settings:AppearanceCard x:Name="AppearanceSettings"
                                   HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel x:Name="BehaviorSection" Spacing="16">
          <TextBlock x:Name="BehaviorSectionHeading"
                     Classes="hero-page-title" />
          <settings:BehaviorCard x:Name="BehaviorSettings"
                                 HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel x:Name="FoldersSection" Spacing="16">
          <TextBlock x:Name="FoldersSectionHeading"
                     Classes="hero-page-title" />
          <settings:FoldersCard x:Name="FolderSettings"
                                HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel x:Name="ToolsSection" Spacing="16">
          <TextBlock x:Name="ToolsSectionHeading"
                     Classes="hero-page-title" />
          <settings:ToolsCard x:Name="ToolSettings"
                              HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel x:Name="UpdatesSection" Spacing="16">
          <TextBlock x:Name="UpdatesSectionHeading"
                     Classes="hero-page-title" />
          <settings:UpdatesCard x:Name="UpdateSettings"
                                HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel x:Name="AboutSection" Spacing="16">
          <TextBlock x:Name="AboutSectionHeading"
                     Classes="hero-page-title" />
          <settings:AboutCard x:Name="AboutSettings"
                              HorizontalAlignment="Stretch" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
