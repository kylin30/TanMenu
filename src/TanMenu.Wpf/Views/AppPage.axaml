<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanMenu.Wpf.ViewModels"
             xmlns:ctl="using:TanMenu.Wpf.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="TanMenu.Wpf.Views.AppPage"
             x:DataType="vm:LauncherViewModel">

  <UserControl.Styles>
    <Style Selector="Button.launcher-tile">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.launcher-tile:pointerover">
      <Setter Property="RenderTransform" Value="translate(0px, -1px)" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Root" Background="Transparent">
    <ctl:OverlayPanel>
      <DockPanel>
        <ui:FAInfoBar x:Name="PinNotice"
                      DockPanel.Dock="Top"
                      Margin="{StaticResource Page.NoticeMargin}"
                      IsOpen="False"
                      IsVisible="False"
                      IsClosable="True"
                      Severity="Informational">
          <ui:FAInfoBar.ActionButton>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.Small}">
              <Button x:Name="PinNowButton" Classes="accent" Click="OnPinNowClick" />
              <Button x:Name="PinNeverButton" Click="OnPinNeverClick" />
            </StackPanel>
          </ui:FAInfoBar.ActionButton>
        </ui:FAInfoBar>

        <ui:FAInfoBar DockPanel.Dock="Top"
                      Margin="{StaticResource Page.NoticeMargin}"
                      IsOpen="{Binding ShowUpdateNotice}"
                      IsVisible="{Binding ShowUpdateNotice}"
                      IsClosable="False"
                      Severity="Informational"
                      Message="{Binding UpdateNoticeText}">
          <ui:FAInfoBar.ActionButton>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.Small}">
              <ProgressBar IsVisible="{Binding IsUpdateDownloading}"
                           Width="96"
                           Minimum="0" Maximum="100"
                           Value="{Binding UpdateProgressPercent}" />
              <Button Content="{Binding UpdateActionText}"
                      IsEnabled="{Binding !IsUpdateDownloading}"
                      Click="OnUpdateNoticeClick" />
            </StackPanel>
          </ui:FAInfoBar.ActionButton>
        </ui:FAInfoBar>

        <ScrollViewer x:Name="Body"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden">
          <ItemsControl Margin="{StaticResource Page.ContentInset}"
                        IsVisible="{Binding HasVisibleItems}"
                        ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.Large}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MenuGroupVm">
                <Border Padding="{StaticResource Card.BottomPadding}"
                        VerticalAlignment="Stretch"
                        IsVisible="{Binding HasVisibleItems}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0"
                            Padding="{StaticResource Card.HeaderPadding}"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                            ColumnSpacing="{StaticResource Spacing.Small}">
                        <Border Grid.Column="0"
                                Width="28"
                                Height="28"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="7">
                          <Panel>
                            <ui:FASymbolIcon Symbol="Folder"
                                             IsVisible="{Binding IsDirectoryClickable}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                            <ui:FASymbolIcon Symbol="AllApps"
                                             IsVisible="{Binding !IsDirectoryClickable}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                          </Panel>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DirectoryName}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Column="2"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="9">
                          <TextBlock Text="{Binding VisibleItemCount}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <Button Grid.Column="3"
                                Theme="{DynamicResource TransparentButton}"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsVisible="{Binding IsDirectoryClickable}"
                                ToolTip.Tip="{Binding TitleTooltip}"
                                AutomationProperties.Name="{Binding TitleTooltip}"
                                Click="OnGroupTitleClick">
                          <ui:FASymbolIcon Symbol="ChevronRight" />
                        </Button>
                      </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1"
                                  Margin="{StaticResource Card.BodyMargin}"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding Columns}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"
                                      Spacing="{StaticResource Spacing.Small}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuColumnVm">
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="{StaticResource Spacing.Small}" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MenuItemVm">
                                <Button Classes="launcher-tile"
                                        MinHeight="36"
                                        Padding="4,2"
                                        CornerRadius="5"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        ToolTip.Tip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}"
                                        IsEnabled="{Binding !IsDisabled}"
                                        Click="OnItemClick"
                                        PointerEntered="OnItemPointerEntered">
                                  <Grid ColumnDefinitions="28,Auto"
                                        ColumnSpacing="{StaticResource Spacing.Small}">
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="5">
                                      <Image Width="22" Height="22"
                                             Source="{Binding Icon}"
                                             Stretch="Uniform"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontWeight="Medium"
                                               MaxWidth="220"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <StackPanel IsVisible="{Binding ShowSplash}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{StaticResource Spacing.Medium}">
        <Image Width="64" Height="64"
               Source="avares://TanMenu.Wpf/wwwroot/app-tile.png" />
        <ui:FAProgressRing Width="32" Height="32"
                           IsActive="{Binding ShowSplash}"
                           IsIndeterminate="True"
                           HorizontalAlignment="Center" />
        <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowEmpty}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{StaticResource Spacing.Small}">
        <TextBlock Text="{Binding EmptyTitleText}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   FontFamily="{Binding TitleFontFamily}" />
        <TextBlock Text="{Binding EmptyHelpText}" MaxWidth="420" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource Spacing.Small}"
                    HorizontalAlignment="Center">
          <Button Classes="accent" Content="{Binding OpenOptionsText}" Click="OnOpenSettingsClick" />
          <Button Content="{Binding MenuRefreshText}" Click="OnRefreshClick" />
        </StackPanel>
      </StackPanel>

      <StackPanel IsVisible="{Binding ShowNoMatches}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{StaticResource Spacing.Small}">
        <TextBlock Text="{Binding NoMatchTitleText}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   FontFamily="{Binding TitleFontFamily}" />
        <TextBlock Text="{Binding NoMatchHelpText}" MaxWidth="420" TextWrapping="Wrap" />
        <Button Content="{Binding ClearFilterText}"
                Click="OnClearFilterClick"
                HorizontalAlignment="Center" />
      </StackPanel>

      <ui:FAInfoBar IsOpen="{Binding HasToast}"
                    IsClosable="False"
                    Message="{Binding ToastText}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="{StaticResource Toast.Margin}"
                    PointerPressed="OnToastPressed" />
    </ctl:OverlayPanel>
  </Panel>
</UserControl>
