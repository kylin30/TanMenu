<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanMenu.Wpf.ViewModels"
             xmlns:ctl="using:TanMenu.Wpf.Controls"
             x:Class="TanMenu.Wpf.Views.AppPage"
             x:DataType="vm:LauncherViewModel">

  <!-- The launcher proper. The window shell owns the title strip (search box and overflow menu now
       live there, Task Manager style — see MainWindow.axaml) and the navigation rail; everything here
       is the 应用 page's own content: the update notice, the categories, and the three non-menu states
       (loading, nothing configured, nothing matched). -->

  <Panel x:Name="Root"
         Background="Transparent"
         Classes.size-small="{Binding IsSmallButtons}"
         Classes.size-medium="{Binding IsMediumButtons}"
         Classes.size-large="{Binding IsLargeButtons}">

    <!-- First child (the main content) is what the overlays measure against; every later child is an
         overlay that contributes no layout size of its own (About and the toast never affect the
         page, which simply fills whatever space the shell's page host gives it). -->
    <ctl:OverlayPanel>

      <DockPanel>

        <!-- Taskbar-pin notice. An inline InfoBar rather than the modal dialog the app used to throw
             up on every reveal: RefreshPinNoticeAsync (AppPage.axaml.cs) opens it whenever the app is
             not yet pinned and 不再提示 has not been chosen, and closes it the moment the pin succeeds
             or the user dismisses it. Docked above the update notice, at the top of the page — the
             shell's title strip (search + overflow) sits above this in the window, not in this page. -->
        <ctl:InfoBar x:Name="PinNotice" DockPanel.Dock="Top" Margin="12,0,12,8"
                     IsOpen="False" Dismissed="OnPinNoticeDismissed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PinNowButton" Click="OnPinNowClick" Padding="14,5" />
            <Button x:Name="PinNeverButton" Click="OnPinNeverClick" Padding="14,5" />
          </StackPanel>
        </ctl:InfoBar>

        <!-- Update notice. Docked above the body rather than inside its scrolling StackPanel: the
             notice is a page-wide banner, not a category, so it must not become a sibling in the
             horizontal row of groups. Only for Available / Downloading / ReadyToRestart. MinWidth is
             deliberate anti-jitter: without it the page's width would change as the "…42%" text grows
             and shrinks during a download. The bottom margin is 0 because the body ScrollViewer's own
             content margin (SurfacePadding) supplies the gap to whatever renders below. -->
        <Button Classes="tm-update"
                DockPanel.Dock="Top"
                Margin="16,16,16,0"
                IsVisible="{Binding ShowUpdateNotice}"
                IsEnabled="{Binding !IsUpdateDownloading}"
                MinWidth="360"
                Click="OnUpdateNoticeClick">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="tm-icon small"
                       Text="&#xE896;" Margin="0,0,10,0" />
            <Border DockPanel.Dock="Right"
                    IsVisible="{Binding IsUpdateDownloading}"
                    Width="84" Height="4" Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    CornerRadius="2"
                    Background="{DynamicResource SubtleFillTertiaryBrush}">
              <Border Background="{DynamicResource AccentDefaultBrush}"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      Width="{Binding UpdateProgressWidth}">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.15" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Border>
            <TextBlock Text="{Binding UpdateNoticeText}"
                       TextWrapping="NoWrap" VerticalAlignment="Center" />
          </DockPanel>
        </Button>

        <!-- ══ Body ═════════════════════════════════════════════════════════════════════════
             Horizontal-only: categories run left to right and the window scrolls sideways when
             they overflow, not up and down. -->
        <ScrollViewer x:Name="Body"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal"
                      Margin="{DynamicResource SurfacePadding}"
                      Spacing="14">

            <!-- 1. The categories, running left to right. Each is a heading plus a column of tiles
                 that fills downward and wraps into the next column at the bottom edge; a category
                 with no visible items after filtering removes itself. -->
            <ItemsControl IsVisible="{Binding HasVisibleItems}" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="24" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MenuGroupVm">
                  <!-- DockPanel, NOT a vertical StackPanel: a vertical StackPanel measures every
                       stacked child with INFINITE height (that is how stacking works — each child is
                       free to be as tall as it wants), so the items WrapPanel below would never see a
                       real height budget and would never wrap into a second column; the category
                       would render as one endless, uncapped column with the overflow invisible past
                       the window edge (there is no vertical scrollbar to reach it). A DockPanel gives
                       the heading its own Top-docked slot and hands the items ItemsControl the
                       GENUINELY REMAINING, finite height — which is what lets the WrapPanel below wrap
                       at the actual bottom edge instead of never wrapping at all. -->
                  <DockPanel Classes="tm-group" IsVisible="{Binding HasVisibleItems}">

                    <!-- A null tooltip shows nothing, which is how the inert 常用工具 heading
                         stays inert. The folder glyph only fades in for a real directory. -->
                    <Border Classes="tm-section-head"
                            Classes.clickable="{Binding IsDirectoryClickable}"
                            ToolTip.Tip="{Binding TitleTooltip}"
                            PointerPressed="OnGroupTitlePressed"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="tm-section" Text="{Binding DirectoryName}"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="tm-icon subtle small tm-folder"
                                   IsVisible="{Binding IsDirectoryClickable}"
                                   Text="&#xE8B7;" />
                      </StackPanel>
                    </Border>

                    <!-- Items fill a column top-to-bottom and wrap into the NEXT COLUMN when they
                         reach the bottom of the window — the pre-Avalonia layout, except that items
                         per column follow the window height instead of a fixed ColButtonCount. -->
                    <ItemsControl ItemsSource="{Binding VisibleItems}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuItemVm">
                          <Button Classes="tm-tile"
                                  Theme="{StaticResource TmTileButton}"
                                  Margin="0,0,4,4"
                                  IsEnabled="{Binding !IsDisabled}"
                                  Click="OnItemClick"
                                  PointerEntered="OnItemPointerEntered">
                            <DockPanel>
                              <!-- The icon slot is always occupied (the build always assigns at
                                   least a fallback), which is why the async icon fill never
                                   reflows the grid. -->
                              <Image Classes="tm-tile-icon"
                                     DockPanel.Dock="Left"
                                     Source="{Binding Icon}"
                                     Margin="0,0,10,0"
                                     Stretch="Uniform"
                                     VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}"
                                         TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

      </DockPanel>

      <!-- ══ Non-menu states (no layout size) ═════════════════════════════════════════════════
           Loading, "nothing configured" and "nothing matched" are page-wide states, not categories,
           so they are NOT siblings inside the horizontal row above — they are centred overlays here,
           measured against the main content's size the same way the toast and About panel below are. -->

      <!-- 2. Loading. ShowLoading tracks visibility so the spinner's infinite animation stops for
           the rest of the (tray-resident) session once the menu arrives. -->
      <ctl:SplashPanel IsVisible="{Binding ShowSplash}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ShowLoading="{Binding ShowSplash}"
                       VersionText="{Binding VersionText}"
                       CopyrightText="{Binding CopyrightText}"
                       HintText="{Binding ClickToDismissText}" />

      <!-- 3. Loaded, but there is genuinely nothing configured. -->
      <StackPanel Classes="tm-empty" IsVisible="{Binding ShowEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{Binding EmptyTitleText}"
                   FontFamily="{Binding TitleFontFamily}" />
        <TextBlock Text="{Binding EmptyHelpText}" MaxWidth="360" />
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,14,0,0">
          <Button Content="{Binding OpenOptionsText}" Click="OnOpenSettingsClick" Padding="14,6" />
          <Button Content="{Binding MenuRefreshText}" Click="OnRefreshClick" Padding="14,6" />
        </StackPanel>
      </StackPanel>

      <!-- 4. There ARE shortcuts, but the filter matched none of them. -->
      <StackPanel Classes="tm-empty" IsVisible="{Binding ShowNoMatches}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{Binding NoMatchTitleText}"
                   FontFamily="{Binding TitleFontFamily}" />
        <TextBlock Text="{Binding NoMatchHelpText}" MaxWidth="360" />
        <Button Content="{Binding ClearFilterText}" Click="OnClearFilterClick"
                Padding="14,6" HorizontalAlignment="Center" Margin="0,14,0,0" />
      </StackPanel>

      <!-- Transient error. Click anywhere on it to dismiss; otherwise it self-clears. -->
      <Border Classes="tm-toast"
              IsVisible="{Binding HasToast}"
              PointerPressed="OnToastPressed">
        <TextBlock Text="{Binding ToastText}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </Border>

      <!-- "关于": the splash on demand. Clicking ANYWHERE on it closes it — there is no close
           button and no Escape handler, which is what the original did too. -->
      <Border IsVisible="{Binding ShowAbout}"
              Background="{DynamicResource SurfaceBaseBrush}"
              CornerRadius="{DynamicResource RadiusOverlay}"
              ClipToBounds="True"
              PointerPressed="OnAboutPressed">
        <ctl:SplashPanel ShowLoading="False"
                         VersionText="{Binding VersionText}"
                         CopyrightText="{Binding CopyrightText}"
                         HintText="{Binding ClickToDismissText}" />
      </Border>

    </ctl:OverlayPanel>
  </Panel>
</UserControl>
