<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanMenu.Wpf.ViewModels"
             xmlns:ctl="using:TanMenu.Wpf.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="TanMenu.Wpf.Views.AppPage"
             x:DataType="vm:LauncherViewModel">

  <Panel x:Name="Root" Background="Transparent">
    <ctl:OverlayPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Margin="16,4,16,0"
                    Spacing="12">
          <ui:FAInfoBar x:Name="PinNotice"
                        Classes="hero-alert"
                        IsOpen="False"
                        IsVisible="False"
                        IsClosable="True"
                        Severity="Informational">
            <ui:FAInfoBar.ActionButton>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PinNowButton" Classes="hero-button hero-primary" Click="OnPinNowClick" />
                <Button x:Name="PinNeverButton" Classes="hero-button" Click="OnPinNeverClick" />
              </StackPanel>
            </ui:FAInfoBar.ActionButton>
          </ui:FAInfoBar>

          <ui:FAInfoBar Classes="hero-alert"
                        IsOpen="{Binding ShowUpdateNotice}"
                        IsVisible="{Binding ShowUpdateNotice}"
                        IsClosable="False"
                        Severity="Informational"
                        Message="{Binding UpdateNoticeText}">
            <ui:FAInfoBar.ActionButton>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar Classes="hero-progress"
                             IsVisible="{Binding IsUpdateDownloading}"
                             Width="96"
                             Minimum="0" Maximum="100"
                             Value="{Binding UpdateProgressPercent}" />
                <Button Content="{Binding UpdateActionText}"
                        Classes="hero-button"
                        IsEnabled="{Binding !IsUpdateDownloading}"
                        Click="OnUpdateNoticeClick" />
              </StackPanel>
            </ui:FAInfoBar.ActionButton>
          </ui:FAInfoBar>

        </StackPanel>

        <ScrollViewer x:Name="Body"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">
          <Grid>
            <ItemsControl Margin="16"
                          ItemsSource="{Binding DisplayGroups}"
                          IsVisible="{Binding HasVisibleItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuGroupVm">
                    <Border Classes="hero-launcher-group-panel"
                            IsVisible="{Binding HasVisibleItems}">
                      <Grid RowDefinitions="Auto,*">
                        <Grid Height="32" ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Classes="hero-section-title"
                                     Text="{Binding DirectoryName}" />
                          <Border Classes="hero-count-badge">
                            <TextBlock Text="{Binding VisibleItemCount}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Hero.MutedBrush}" />
                          </Border>
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="hero-button hero-icon-button"
                                  IsVisible="{Binding IsDirectoryClickable}"
                                  ToolTip.Tip="{Binding TitleTooltip}"
                                  AutomationProperties.Name="{Binding TitleTooltip}"
                                  Click="OnGroupTitleClick">
                            <ui:FASymbolIcon Symbol="OpenFolder" FontSize="14" />
                          </Button>
                        </Grid>

                        <ItemsControl Grid.Row="1"
                                      Margin="0,12,0,0"
                                      ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MenuColumnVm">
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuItemVm">
                                  <Button Classes="hero-launcher-command tm-tile"
                                          Height="36"
                                          MinWidth="112"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding !IsDisabled}"
                                          ToolTip.Tip="{Binding FullPath}"
                                          Click="OnItemClick"
                                          PointerEntered="OnItemPointerEntered">
                                    <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                                      <Border Classes="hero-launcher-command-icon">
                                        <Image Source="{Binding Icon}"
                                               Width="20" Height="20"
                                               Stretch="Uniform" />
                                      </Border>
                                      <TextBlock Grid.Column="1"
                                                 Text="{Binding Name}"
                                                 FontSize="12"
                                                 FontWeight="Medium"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="NoWrap" />
                                    </Grid>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            <Border Classes="hero-empty-state"
                    Margin="24"
                    IsVisible="{Binding ShowSplash}">
              <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Image Width="48" Height="48" Source="/wwwroot/app-tile.png" />
                <ProgressBar Classes="hero-progress" Width="160" IsIndeterminate="True" />
                <TextBlock Text="{Binding VersionText}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Hero.MutedBrush}" />
              </StackPanel>
            </Border>

            <Border Classes="hero-empty-state"
                    Margin="24"
                    IsVisible="{Binding ShowEmpty}">
              <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="460">
                <Border Classes="hero-empty-icon">
                  <ui:FASymbolIcon Symbol="Folder" FontSize="24" />
                </Border>
                <TextBlock Classes="hero-empty-title" Text="{Binding EmptyTitleText}" />
                <TextBlock Classes="hero-empty-description" Text="{Binding EmptyHelpText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                  <Button Classes="hero-button hero-primary" Content="{Binding OpenOptionsText}" Click="OnOpenSettingsClick" />
                  <Button Classes="hero-button" Content="{Binding MenuRefreshText}" Click="OnRefreshClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="hero-empty-state"
                    Margin="24"
                    IsVisible="{Binding ShowNoMatches}">
              <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="460">
                <Border Classes="hero-empty-icon">
                  <ui:FASymbolIcon Symbol="Find" FontSize="24" />
                </Border>
                <TextBlock Classes="hero-empty-title" Text="{Binding NoMatchTitleText}" />
                <TextBlock Classes="hero-empty-description" Text="{Binding NoMatchHelpText}" TextWrapping="Wrap" />
                <Button Classes="hero-button hero-primary"
                        HorizontalAlignment="Center"
                        Content="{Binding ClearFilterText}"
                        Click="OnClearFilterClick" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </DockPanel>

      <Border Classes="hero-toast"
              Margin="24"
              IsVisible="{Binding HasToast}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              PointerPressed="OnToastPressed">
        <TextBlock Text="{Binding ToastText}" />
      </Border>
    </ctl:OverlayPanel>
  </Panel>
</UserControl>
