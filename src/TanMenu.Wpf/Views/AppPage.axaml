<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TanMenu.Wpf.ViewModels"
             xmlns:ctl="using:TanMenu.Wpf.Controls"
             x:Class="TanMenu.Wpf.Views.AppPage"
             x:DataType="vm:LauncherViewModel">

  <!-- The launcher proper. The window shell owns the Aero caption and the navigation rail; everything
       here is the 应用 page's own content: the search header, the update notice, the categories, and the
       three non-menu states (loading, nothing configured, nothing matched).

       Round 7, Task 1 brought the search field BACK here, where it lived before commit 6d00060. Rounds
       2-6 had it in the window's title strip, Task Manager style; the Aero conversion deletes that strip
       because Microsoft's own window-frame guidance is verbatim "Don't add controls to a window frame.
       Put the controls within the window instead."
       (https://learn.microsoft.com/en-us/windows/win32/uxguide/win-window-frames). Only the FIELD
       reverts: the ⋯ overflow button and the page-close glyph that shared that old header do not come
       back — Round 3 Task 2 moved 打开主目录/刷新/退出 into the rail's footer and Round 5 item 2 made 关于
       a settings card, and re-adding the flyout would restage the exact pattern those two rounds
       removed. -->


  <!-- Round 3, Task 4 removed the 小/中/大 button-size setting, so the Classes.size-* bindings this
       Panel used to carry (each wired to LauncherViewModel.IsSmallButtons/IsMediumButtons/
       IsLargeButtons — bindings and properties alike since deleted) went with it. Task 4 left every
       tile at the single fixed width that setting had called "小" (a 168 DIP Width Setter on
       TmTileButton); Round 4, item 3 deleted that Setter in turn, so TmTileButton
       (Themes/Fluent2/Launcher.axaml) now sets no Width at all and a tile is as wide as its own
       icon-plus-label content. Its header comment has the 48 DIP chrome arithmetic and the reason
       columns still come out uniform — the ABSENCE of a HorizontalAlignment on the tile Button
       further down this file. -->
  <Panel x:Name="Root"
         Background="Transparent">

    <!-- First child (the main content) is what the overlays measure against; every later child is an
         overlay that contributes no layout size of its own (the splash, the two non-menu states and the
         toast never affect the page, which simply fills whatever space the shell's page host gives
         it). -->
    <ctl:OverlayPanel>

      <DockPanel>

        <!-- ══ Search header ═══════════════════════════════════════════════════════════════════════
             ctrl-search-boxes puts a primary-entry-point search box "centered at the top of the
             window" (https://learn.microsoft.com/en-us/windows/win32/uxguide/ctrl-search-boxes), which
             is exactly where this sits — one row above everything else the page docks, centred in it.

             THE 320 DIP WIDTH IS AUTHORED, and nothing published fixes it: ctrl-search-boxes states no
             width rule at all and its sizing section is an image. 320 holds the longest prompt this app
             ships in either language plus the "additional 30 percent" localisation allowance
             ctrl-drop publishes (https://learn.microsoft.com/en-us/windows/win32/uxguide/ctrl-drop).
             It is a fixed width, not a proportional one: the Task-Manager-measured 0.34 × client ratio
             that drove this field through Rounds 3-6 was a property of a control living in the window's
             own chrome, and a field inside the page has no reason to track the window — deleting the
             tracking is what removes ApplySearchFieldWidth, its three constants and MainWindow's
             ClientSize subscription without adding a sixth re-fit trigger.

             Round 7, Task 1 restores the MINIMUM: the field's Aero treatment (Border.tm-searchfield is
             still the Fluent 2 shape here) is Task 9's, not this task's. -->
        <Border Classes="tm-header" DockPanel.Dock="Top">
          <Border Classes="tm-searchfield" x:Name="SearchField"
                  Width="320"
                  HorizontalAlignment="Center">
            <Panel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="tm-icon subtle small"
                           Text="&#xE721;" Margin="0,0,8,0" />
                <!-- Background and BorderThickness are LOCAL values on purpose: a local value outranks
                     a style setter for the SAME property on the SAME element, so the TextBox itself
                     paints nothing over the fill Border.tm-searchfield already draws.

                     What that does NOT block is a theme rule aimed at a NAMED PART inside the TextBox
                     control template — a different element, with no local value of its own, whatever
                     is set here. Under the vendored Aero theme that part is Border#BgElement and the
                     rules that reach it are :pointerover and :focus. See Launcher.axaml's two
                     "TextBox.tm-search…/template/ Border#BgElement" rules for what suppresses them and
                     why the BorderBrush half needs no rule. (Before Round 7 Task 4 the part was
                     Fluent's Border#PART_BorderElement and the rule was a single :focus one.) -->
                <TextBox x:Name="SearchBox"
                         Classes="tm-search"
                         AutomationProperties.Name="{Binding SearchPlaceholderText}"
                         Background="Transparent"
                         BorderThickness="0"
                         PlaceholderText="{Binding SearchPlaceholderText}"
                         Text="{Binding Filter, Mode=TwoWay}"
                         KeyDown="OnSearchKeyDown"
                         GotFocus="OnSearchFocusChanged"
                         LostFocus="OnSearchFocusChanged" />
              </DockPanel>
              <!-- The focused-TextBox accent underline (Launcher.axaml's own remarks on
                   Border.tm-searchfield.focused explain why this is a second element rather than a
                   BorderBrush change): transparent at rest, painted only while SearchField carries the
                   "focused" class. IsHitTestVisible="False" keeps it from ever stealing a click from the
                   TextBox it sits on top of — it draws over the DockPanel only because it is the LATER
                   child in this Panel, not because it needs input. -->
              <Border Classes="tm-searchfield-focusbar"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Height="2"
                      Margin="1,0,1,1"
                      CornerRadius="0,0,3,3" />
            </Panel>
          </Border>
        </Border>

        <!-- Taskbar-pin notice. An inline InfoBar rather than the modal dialog the app used to throw
             up on every reveal: RefreshPinNoticeAsync (AppPage.axaml.cs) opens it whenever the app is
             not yet pinned and 不再提示 has not been chosen, and closes it the moment the pin succeeds
             or the user dismisses it. Docked below the search header and above the update notice.

             PinNowButton/PinNeverButton were still default Avalonia Fluent-1 buttons — a scope gap Task
             3 introduced (its own plan scoped "buttons are wrong" to settings-card buttons, but the
             user's complaint was blanket). The local Padding="14,5" is removed from both, same as every
             settings-card button in that task: a local value would outrank the theme's own Padding
             setter and defeat it.

             Both are on TmButton since Round 7, Task 3. PinNowButton used to carry TmAccentButton, on
             the criterion "the one button on its row, and it does the useful thing", so that 固定到任务栏
             looked the same here as it did on BehaviorCard's row. That criterion did not survive the
             Aero conversion: Windows 7 had no accent-filled default button, so TmAccentButton was
             deleted rather than restyled, and the pair now differ by position and label alone. Nothing
             else about this InfoBar changed. -->
        <ctl:InfoBar x:Name="PinNotice" DockPanel.Dock="Top" Margin="12,0,12,8"
                     IsOpen="False" Dismissed="OnPinNoticeDismissed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PinNowButton" Theme="{StaticResource TmButton}" Click="OnPinNowClick" />
            <Button x:Name="PinNeverButton" Theme="{StaticResource TmButton}" Click="OnPinNeverClick" />
          </StackPanel>
        </ctl:InfoBar>

        <!-- Update notice. Docked above the body rather than inside its scrolling StackPanel: the
             notice is a page-wide banner, not a category, so it must not become a sibling in the
             horizontal row of groups. Only for Available / Downloading / ReadyToRestart. MinWidth is
             deliberate anti-jitter: without it the page's width would change as the "…42%" text grows
             and shrinks during a download. The bottom margin is 0 because the body ScrollViewer's own
             content margin (SurfacePadding) supplies the gap to whatever renders below. -->
        <Button Classes="tm-update"
                DockPanel.Dock="Top"
                Margin="16,16,16,0"
                IsVisible="{Binding ShowUpdateNotice}"
                IsEnabled="{Binding !IsUpdateDownloading}"
                MinWidth="360"
                Click="OnUpdateNoticeClick">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Classes="tm-icon small"
                       Text="&#xE896;" Margin="0,0,10,0" />
            <Border DockPanel.Dock="Right"
                    IsVisible="{Binding IsUpdateDownloading}"
                    Width="84" Height="4" Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    CornerRadius="2"
                    Background="{DynamicResource SubtleFillTertiaryBrush}">
              <Border Background="{DynamicResource AccentDefaultBrush}"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      Width="{Binding UpdateProgressWidth}">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.15" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Border>
            <TextBlock Text="{Binding UpdateNoticeText}"
                       TextWrapping="NoWrap" VerticalAlignment="Center" />
          </DockPanel>
        </Button>

        <!-- ══ Body ═════════════════════════════════════════════════════════════════════════
             Horizontal-only: categories run left to right and the window scrolls sideways when
             they overflow, not up and down. -->
        <ScrollViewer x:Name="Body"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <!-- No Spacing on this panel. It has exactly ONE child — the categories ItemsControl below —
               so the Spacing="14" it carried until Round 6, item 4 never applied to anything; it was
               removed rather than left, because the very next edit to add a second child here would
               have silently activated a 14 DIP gap nobody chose. -->
          <StackPanel Orientation="Horizontal"
                      Margin="{DynamicResource SurfacePadding}">

            <!-- 1. The categories, running left to right. Each is a PANEL (Border.tm-group-panel,
                 Round 6, item 4 — that style carries the fill/radius/padding measurements and why the
                 page departs from Windows 11 here) wrapping a heading plus columns of tiles that fill
                 top-to-bottom, wrapping into a new column once a column reaches ColButtonCount items
                 (设置 → 外观 → 每列个数, default 10); a category with no visible items after filtering
                 removes itself.

                 Spacing 12, not the 24 this panel carried before item 4: 12 is the gutter Windows 11
                 puts between its large side-by-side tiles, and the panels now supply the separation the
                 wider gap was doing on its own. Halving it also pays for most of the panels' chrome.
                 The AUTHORED arithmetic is 5 x 22 for the five panels less 4 x 12 given back here, a
                 net +62 (22 = 12 + 8 of padding plus 2 x 1 of border). That is not what this machine
                 renders: a 1 DIP stroke LAYS OUT as 2 physical px = 1.3333 DIP at 150 %, the rounding
                 Launcher.axaml's tm-page-pane border block already records, so a panel really costs
                 22.6667 per axis and the shipped page grew +65.3333 = 5 x 22.6667 less 4 x 12.
                 Measured: the fit line went page 1643.3333 to 1708.6667 wide, and the four gaps here
                 are 18 px each, exactly 12 DIP. Re-derive with the authored 1, not the 1.3333, at
                 another scale. -->
            <ItemsControl IsVisible="{Binding HasVisibleItems}" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MenuGroupVm">
                  <!-- A plain vertical StackPanel is enough now: the column cap is enforced by DATA
                       (MenuGroupVm.Columns, chunked from VisibleItems by
                       TanMenu.Core.Services.MenuLayout.ChunkIntoColumns at GeneralConfig.ColButtonCount
                       items per column — Round 3, Task 4), not by handing an inner panel a real,
                       finite height budget the way the DockPanel-plus-vertical-WrapPanel this replaced
                       had to (that panel needed the trick because WindowHost.FitToContent measures the
                       whole page with an UNBOUNDED height probe: an item-count cap decided in the data
                       survives that probe unchanged, whereas a height-based wrap would never wrap at
                       all under an infinite budget — see that method's own remarks). -->
                  <!-- Round 6, item 4 puts every category in a panel. The wrapping Border is what carries
                       IsVisible, and MOVING the binding off the StackPanel onto it is load-bearing rather
                       than cosmetic: the recon measured that when a filter hides a category, the generated
                       ItemsControl CONTAINER stays visible at zero size and only the bound child collapses
                       (with the box set to "Steam", four of five group containers reported an empty UIA
                       rect while the items panel still measured 187.33 DIP = the surviving group's 91.33
                       plus 4 x the inter-category gap). Leave the binding on the inner StackPanel and every
                       filtered-out category renders as an empty bordered box 22 DIP wide.
                       AppPageGroupTests guards exactly that, because nothing else would see it until
                       somebody types in the search box. -->
                  <Border Classes="tm-group-panel" IsVisible="{Binding HasVisibleItems}">
                    <StackPanel Classes="tm-group">

                      <!-- A null tooltip shows nothing, which is how the inert 常用工具 heading
                           stays inert. The folder glyph only fades in for a real directory. -->
                      <Border Classes="tm-section-head"
                              Classes.clickable="{Binding IsDirectoryClickable}"
                              ToolTip.Tip="{Binding TitleTooltip}"
                              PointerPressed="OnGroupTitlePressed"
                              Margin="0,0,0,6"
                              HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="tm-section" Text="{Binding DirectoryName}"
                                     MaxWidth="320" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="tm-icon subtle small tm-folder"
                                     IsVisible="{Binding IsDirectoryClickable}"
                                     Text="&#xE8B7;" />
                        </StackPanel>
                      </Border>

                      <!-- Columns, left to right; each holds at most ColButtonCount items, top to
                           bottom — the pre-Avalonia layout's own shape, restored. The outer ItemsControl
                           below walks MenuGroupVm.Columns (one MenuColumnVm per column); the inner one
                           walks that column's own Items. Two levels, not one WrapPanel, because
                           compiled bindings (required for the NativeAOT publish) need a concrete
                           x:DataType per DataTemplate, and a bare IReadOnlyList&lt;MenuItemVm&gt; has no
                           name of its own to bind against — see MenuColumnVm's own remarks. -->
                      <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MenuColumnVm">
                            <ItemsControl ItemsSource="{Binding Items}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuItemVm">
                                  <Button Classes="tm-tile"
                                          Theme="{StaticResource TmTileButton}"
                                          Margin="0,0,4,4"
                                          IsEnabled="{Binding !IsDisabled}"
                                          Click="OnItemClick"
                                          PointerEntered="OnItemPointerEntered">
                                    <DockPanel>
                                      <!-- The icon slot is always occupied (the build always assigns at
                                           least a fallback), which is why the async icon fill never
                                           reflows the grid. -->
                                      <Image Classes="tm-tile-icon"
                                             DockPanel.Dock="Left"
                                             Source="{Binding Icon}"
                                             Margin="0,0,10,0"
                                             Stretch="Uniform"
                                             VerticalAlignment="Center" />
                                      <!-- NoWrap and NO TextTrimming: Round 4, item 3 sizes the tile to
                                           this label instead of trimming the label to the tile, so
                                           there is nothing left for a trimmer to do — measured on the
                                           running build, all 74 labels' ink ended inside their tile's
                                           padding box, the tightest with 0.67 DIP to spare. NoWrap is
                                           load-bearing twice: it is what makes the label's desired
                                           width a single-line advance, and it keeps every tile the
                                           same height, which is what FindAdjacentTile's sameRow test
                                           keys off (code-behind, current.Bounds.Height / 2). -->
                                      <TextBlock Text="{Binding Name}"
                                                 TextWrapping="NoWrap"
                                                 VerticalAlignment="Center" />
                                    </DockPanel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

      </DockPanel>

      <!-- ══ Non-menu states (no layout size) ═════════════════════════════════════════════════
           Loading, "nothing configured" and "nothing matched" are page-wide states, not categories,
           so they are NOT siblings inside the horizontal row above — they are centred overlays here,
           measured against the main content's size the same way the toast below is. -->

      <!-- 2. Loading. ShowLoading tracks visibility so the spinner's infinite animation stops for
           the rest of the (tray-resident) session once the menu arrives. -->
      <ctl:SplashPanel IsVisible="{Binding ShowSplash}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ShowLoading="{Binding ShowSplash}"
                       VersionText="{Binding VersionText}"
                       CopyrightText="{Binding CopyrightText}" />

      <!-- 3. Loaded, but there is genuinely nothing configured. Both recovery buttons were still
           default Avalonia Fluent-1 buttons — found while auditing the app for Task 3's scope gap (see
           the PinNotice comment above); neither is named in that gap's own brief, but they are the same
           kind of miss. Two peer actions, neither a single obvious default — plain TmButton for both,
           same criterion FoldersCard's own peer-action rows use. -->
      <StackPanel Classes="tm-empty" IsVisible="{Binding ShowEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{Binding EmptyTitleText}"
                   FontFamily="{Binding TitleFontFamily}" />
        <TextBlock Text="{Binding EmptyHelpText}" MaxWidth="360" />
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,14,0,0">
          <Button Theme="{StaticResource TmButton}" Content="{Binding OpenOptionsText}" Click="OnOpenSettingsClick" />
          <Button Theme="{StaticResource TmButton}" Content="{Binding MenuRefreshText}" Click="OnRefreshClick" />
        </StackPanel>
      </StackPanel>

      <!-- 4. There ARE shortcuts, but the filter matched none of them. The clear-filter button is the
           other button this Task's brief names explicitly (the PinNotice comment above covers the
           other scope-gap fix). It is a reset, the same category as the settings page's HotkeyClearBtn
           (Task 3 kept that one plain rather than accented "because clearing is a reset, not an
           affirmative action") — plain TmButton here for the identical reason. -->
      <StackPanel Classes="tm-empty" IsVisible="{Binding ShowNoMatches}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{Binding NoMatchTitleText}"
                   FontFamily="{Binding TitleFontFamily}" />
        <TextBlock Text="{Binding NoMatchHelpText}" MaxWidth="360" />
        <Button Theme="{StaticResource TmButton}" Content="{Binding ClearFilterText}" Click="OnClearFilterClick"
                HorizontalAlignment="Center" Margin="0,14,0,0" />
      </StackPanel>

      <!-- Transient error. Click anywhere on it to dismiss; otherwise it self-clears. -->
      <Border Classes="tm-toast"
              IsVisible="{Binding HasToast}"
              PointerPressed="OnToastPressed">
        <TextBlock Text="{Binding ToastText}"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </Border>

      <!-- The "关于" overlay used to be the last child here: the same SplashPanel with ShowLoading
           false, covering the page, dismissed by a click anywhere. Round 5, item 2 ("关于集成到设置页中")
           deleted it outright rather than hiding it — 关于 is a card at the bottom of the 设置 page now
           (Views/Settings/AboutCard.axaml). Its rail row, OnAboutClick, LauncherViewModel's
           ShowAbout/OpenAbout/CloseAbout, this file's OnAboutPressed, SplashPanel's dismiss hint and the
           ClickToDismiss language key went with it, and Tokens.axaml's RadiusOverlay lost its only
           consumer. -->

    </ctl:OverlayPanel>
  </Panel>
</UserControl>
