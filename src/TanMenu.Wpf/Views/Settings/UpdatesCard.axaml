<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.UpdatesCard">
  <ui:FASettingsExpander x:Name="UpdateStatusRow" IconSource="Sync">
    <ui:FASettingsExpander.Header>
      <TextBlock x:Name="UpdateStatusLabel" />
    </ui:FASettingsExpander.Header>
    <ui:FASettingsExpander.Footer>
      <StackPanel Spacing="8" HorizontalAlignment="Right">
        <ProgressBar x:Name="UpdateProgress"
                     Width="220"
                     Minimum="0" Maximum="100"
                     IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CheckUpdateBtn" Click="OnCheckUpdateClick" />
          <Button x:Name="UpdateActionBtn" Click="OnUpdateActionClick" IsVisible="False" />
        </StackPanel>
      </StackPanel>
    </ui:FASettingsExpander.Footer>
  </ui:FASettingsExpander>
</UserControl>
