<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TanMenu.Wpf.Views.Settings.FoldersCard">
  <!-- Three Windows 11 Settings-style rows: an icon, a title + secondary line(s), and the control(s)
       trailing — same Grid(Auto,*,Auto) shape AppearanceCard established (see its code-behind for the
       full ReloadFromConfig contract every settings card group follows, and for why this is a Grid and
       never a DockPanel).

       主文件夹 adds its live path as an extra TextBlock inside the SAME Grid.Column="1" stack as the
       title/sub, not below the Grid as a sibling: an absolute path has no whitespace for Wrap to break
       on, so putting it below the Grid (in its own StackPanel, the way BehaviorCard's pin-status/
       hotkey-help lines do) let its unbroken width dictate the whole card's width instead of being
       clamped by the star column — confirmed by screenshot, where a long path pushed 选择… to the
       window's edge. Moving it inside column 1 was necessary but not sufficient on its own: a NoWrap +
       CharacterEllipsis TextBlock still reports its full, un-ellipsized single-line text as its
       MEASURE-time desired width (trimming is a paint-time concern, applied only once the width it's
       actually given at arrange time is narrower than that) — so an untruncated long path still inflated
       column 1's minimum, just less catastrophically than Wrap's version. An explicit MaxWidth on the
       path TextBlock is what actually bounds the desired width fed into measurement, independent of the
       text's own length. ReloadFromConfig sets a matching ToolTip so the full path is one hover away.

       数据文件夹 and 维护 each need THREE trailing buttons rather than 主文件夹's two, and even with the
       path fix above, three buttons sharing column 2 with column 1's title/sub/path left no room at the
       app's own documented minimum window width (WindowHost.MinWidthDip = 760): 重置为默认/恢复… were
       clipped past the visible edge — confirmed by resizing to exactly that minimum and re-screenshotting,
       not by inspection. Column 2 is left empty on these two rows; their buttons go on their own full-width
       row below instead, indented to align under the title (30px = the icon column's width + its right
       margin, the same indent BehaviorCard uses for its own below-row content) — full card width is far
       more room than a shared trailing column, and there is nothing else competing for it. -->
  <StackPanel>
    <TextBlock x:Name="GroupHead" Classes="tm-group-head" />

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE8B7;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="MainFolderTitle" Classes="tm-card-title" />
          <TextBlock x:Name="MainFolderSub" Classes="tm-card-sub" />
          <TextBlock x:Name="RootPathText" Classes="tm-card-sub" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenRootBtn" Theme="{StaticResource TmButton}"
                  Click="OnOpenRootClick" VerticalAlignment="Center" />
          <Button x:Name="PickRootBtn" Theme="{StaticResource TmButton}"
                  Click="OnPickRootClick" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE8B7;" Margin="0,0,14,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="DataFolderTitle" Classes="tm-card-title" />
            <TextBlock x:Name="DataFolderSub" Classes="tm-card-sub" />
            <TextBlock x:Name="DataPathText" Classes="tm-card-sub" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,6,0,0" />
            <!-- Short (kind + size) and never really at risk of overflow, but trimmed too rather than
                 left as the one inconsistent sibling. -->
            <TextBlock x:Name="DataInfoText" Classes="tm-card-sub" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,2,0,0" />
          </StackPanel>
          <!-- Column 2 deliberately empty here — see the class-level remark above. -->
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="30,10,0,0">
          <Button x:Name="OpenDataBtn" Theme="{StaticResource TmButton}"
                  Click="OnOpenDataClick" VerticalAlignment="Center" />
          <Button x:Name="ChangeDataBtn" Theme="{StaticResource TmButton}"
                  Click="OnChangeDataClick" VerticalAlignment="Center" />
          <Button x:Name="ResetDataBtn" Theme="{StaticResource TmButton}"
                  Click="OnResetDataClick" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="tm-card">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE74D;" Margin="0,0,14,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="MaintenanceTitle" Classes="tm-card-title" />
            <TextBlock x:Name="MaintenanceSub" Classes="tm-card-sub" />
          </StackPanel>
          <!-- Column 2 deliberately empty here — see the class-level remark above. -->
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="30,10,0,0">
          <Button x:Name="ClearCacheBtn" Theme="{StaticResource TmButton}"
                  Click="OnClearCacheClick" VerticalAlignment="Center" />
          <Button x:Name="BackupBtn" Theme="{StaticResource TmButton}"
                  Click="OnBackupConfigClick" VerticalAlignment="Center" />
          <Button x:Name="RestoreBtn" Theme="{StaticResource TmButton}"
                  Click="OnRestoreConfigClick" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
