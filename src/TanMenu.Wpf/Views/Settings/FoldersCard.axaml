<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.FoldersCard">
  <StackPanel Spacing="12">
    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Folder" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="MainFolderHead" Classes="hero-setting-label" />
          <TextBlock x:Name="MainFolderDescription" Classes="hero-setting-description" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="OpenRootBtn" Classes="hero-button" Click="OnOpenRootClick" />
          <Button x:Name="PickRootBtn" Classes="hero-button" Click="OnPickRootClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="SaveLocal" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="DataFolderHead" Classes="hero-setting-label" />
          <TextBlock x:Name="DataFolderDescription" Classes="hero-setting-description" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="OpenDataBtn" Classes="hero-button" Click="OnOpenDataClick" />
          <Button x:Name="ChangeDataBtn" Classes="hero-button" Click="OnChangeDataClick" />
          <Button x:Name="ResetDataBtn" Classes="hero-button" Click="OnResetDataClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Delete" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="CacheHead" Classes="hero-setting-label" />
          <TextBlock x:Name="CacheDescription" Classes="hero-setting-description" />
        </StackPanel>
        <Button x:Name="ClearCacheBtn" Grid.Column="2" Classes="hero-button" VerticalAlignment="Center" Click="OnClearCacheClick" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Save" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="BackupHead" Classes="hero-setting-label" />
          <TextBlock x:Name="BackupDescription" Classes="hero-setting-description" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="BackupBtn" Classes="hero-button" Click="OnBackupConfigClick" />
          <Button x:Name="RestoreBtn" Classes="hero-button" Click="OnRestoreConfigClick" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
