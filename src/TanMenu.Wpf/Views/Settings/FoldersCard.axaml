<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.FoldersCard">
  <StackPanel Spacing="4">
    <ui:FASettingsExpander x:Name="MainFolderRow" IconSource="Folder">
      <ui:FASettingsExpander.Header><TextBlock x:Name="MainFolderHead" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenRootBtn" Click="OnOpenRootClick" />
          <Button x:Name="PickRootBtn" Click="OnPickRootClick" />
        </StackPanel>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="DataFolderRow" IconSource="SaveLocal">
      <ui:FASettingsExpander.Header><TextBlock x:Name="DataFolderHead" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenDataBtn" Click="OnOpenDataClick" />
          <Button x:Name="ChangeDataBtn" Click="OnChangeDataClick" />
          <Button x:Name="ResetDataBtn" Click="OnResetDataClick" />
        </StackPanel>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="CacheRow" IconSource="Delete">
      <ui:FASettingsExpander.Header><TextBlock x:Name="CacheHead" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <Button x:Name="ClearCacheBtn" Click="OnClearCacheClick" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="BackupRow" IconSource="Save">
      <ui:FASettingsExpander.Header><TextBlock x:Name="BackupHead" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="BackupBtn" Click="OnBackupConfigClick" />
          <Button x:Name="RestoreBtn" Click="OnRestoreConfigClick" />
        </StackPanel>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>
  </StackPanel>
</UserControl>
