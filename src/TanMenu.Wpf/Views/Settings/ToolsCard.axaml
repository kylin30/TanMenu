<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.ToolsCard">
  <StackPanel Spacing="4">
    <ui:FASettingsExpander x:Name="ShowToolsRow" IconSource="List">
      <ui:FASettingsExpander.Header><TextBlock x:Name="ShowToolsLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch x:Name="ShowToolsToggle" IsCheckedChanged="OnShowToolsChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="ToolsList" IconSource="Bullets" IsExpanded="True">
      <ui:FASettingsExpander.Header><TextBlock x:Name="ToolsListLabel" /></ui:FASettingsExpander.Header>
    </ui:FASettingsExpander>
  </StackPanel>
</UserControl>
