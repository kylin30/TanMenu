<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.ToolsCard">
  <StackPanel Spacing="12">
    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="List" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="ShowToolsLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="ShowToolsDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ToggleSwitch x:Name="ShowToolsToggle" Grid.Column="2" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnShowToolsChanged" />
      </Grid>
    </Border>

    <Border x:Name="ToolsList" Classes="hero-setting-group">
      <StackPanel>
        <Grid Margin="16,12" ColumnDefinitions="36,*" ColumnSpacing="12">
          <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Bullets" FontSize="16" /></Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock x:Name="ToolsListLabel" Classes="hero-setting-label" />
            <TextBlock x:Name="ToolsListDescription" Classes="hero-setting-description" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="ToolsListItems" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
