<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TanMenu.Wpf.Views.Settings.ToolsCard">
  <!-- One Windows 11 Settings-style row (icon, title + secondary line, master ToggleSwitch — same
       Grid(Auto,*,Auto) shape AppearanceCard established, see its code-behind for the full
       ReloadFromConfig contract every settings card group follows), plus a bordered, scrolling list of
       per-tool CheckBoxes below it inside the SAME tm-card Border — same below-row placement
       BehaviorCard's hotkey help text and FoldersCard's maintenance buttons use, indented 30px (the
       icon column's width + its right margin) to align under the title.

       MaxHeight="240" on the ScrollViewer (ported verbatim from SettingsWindow's 常用工具 tab) is what
       keeps a long DefaultTools list (config.json is user-editable — see the code-behind) from pushing
       whatever settings groups come after this one off screen. -->
  <StackPanel>
    <TextBlock x:Name="GroupHead" Classes="tm-group-head" />

    <Border Classes="tm-card">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE90F;" Margin="0,0,14,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="ShowToolsTitle" Classes="tm-card-title" />
            <TextBlock x:Name="ShowToolsSub" Classes="tm-card-sub" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" x:Name="ShowToolsToggle" OnContent="" OffContent=""
                        VerticalAlignment="Center" IsCheckedChanged="OnShowToolsChanged" />
        </Grid>

        <!-- Disabled (not hidden) while ShowToolsToggle is off — ported verbatim from
             SettingsWindow.BuildToolCheckboxes ("Unchecking only disables the list; the individual
             states stay and are still persisted"): the per-tool Show values keep whatever the user set
             so re-enabling the category does not silently reset which tools it contains. -->
        <Border Margin="30,10,0,0" Padding="8,4"
                BorderBrush="{DynamicResource StrokeControlBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusControl}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
            <StackPanel x:Name="ToolsPanel" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
