<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TanMenu.Wpf.Views.Settings.AppearanceCard">
  <!-- Four Windows 11 Settings-style rows: an icon, a title + secondary line, and the control
       trailing. Populated by ReloadFromConfig — see the code-behind for the ReloadFromConfig
       contract every settings card group follows.

       Each row is a Grid (Auto,*,Auto), not a DockPanel. Built first with a DockPanel per row (icon
       docked left, control docked right, a plain StackPanel as the fill child), the longest subtitle
       (按钮大小's, and the even longer English wording) clipped mid-glyph against the ComboBox's left
       edge instead of wrapping onto a second line — confirmed by screenshot, not by inspection. The
       exact DockPanel measure/arrange interaction that produced the clipping was not isolated, so no
       claim is made about it here. Switching to a Grid fixed it: a Grid's star column is guaranteed to
       resolve to the same width at both measure and arrange time, so the middle TextBlock always wraps
       against the width it is actually given, regardless of column order or which sibling is docked
       where. Re-verified by screenshot in both Chinese and English after the change. -->
  <StackPanel>
    <TextBlock x:Name="GroupHead" Classes="tm-group-head" />

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE774;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="LanguageTitle" Classes="tm-card-title" />
          <TextBlock x:Name="LanguageSub" Classes="tm-card-sub" />
        </StackPanel>
        <ComboBox Grid.Column="2" x:Name="LanguageCombo" Width="220" VerticalAlignment="Center"
                  SelectionChanged="OnLanguageChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE793;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="AppearanceTitle" Classes="tm-card-title" />
          <TextBlock x:Name="AppearanceSub" Classes="tm-card-sub" />
        </StackPanel>
        <ComboBox Grid.Column="2" x:Name="AppearanceCombo" Width="220" VerticalAlignment="Center"
                  SelectionChanged="OnAppearanceChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE8D2;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="FontTitle" Classes="tm-card-title" />
          <TextBlock x:Name="FontSub" Classes="tm-card-sub" />
        </StackPanel>
        <!-- IsTextSearchEnabled restores the WPF list's type-ahead: with hundreds of installed
             families, typing the first letters is how the list is actually navigated. The rows are
             ComboBoxItems whose Content is the display name, so no TextSearch.TextPath is needed, and
             the disabled group-header rows are skipped because they are not selectable. -->
        <ComboBox Grid.Column="2" x:Name="FontCombo" Width="220" MaxDropDownHeight="320"
                  IsTextSearchEnabled="True" VerticalAlignment="Center"
                  SelectionChanged="OnFontChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE8A9;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="SizeTitle" Classes="tm-card-title" />
          <TextBlock x:Name="SizeSub" Classes="tm-card-sub" />
        </StackPanel>
        <ComboBox Grid.Column="2" x:Name="SizeCombo" Width="220" VerticalAlignment="Center"
                  SelectionChanged="OnSizeChanged" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
