<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.AppearanceCard">
  <StackPanel Spacing="4">
    <ui:FASettingsExpander x:Name="LanguageRow" IconSource="Globe">
      <ui:FASettingsExpander.Header>
        <TextBlock x:Name="LanguageLabel" />
      </ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ComboBox x:Name="LanguageCombo"
                  Width="240"
                  AutomationProperties.LabeledBy="{Binding #LanguageLabel}"
                  SelectionChanged="OnLanguageChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="AppearanceRow" IconSource="View">
      <ui:FASettingsExpander.Header>
        <TextBlock x:Name="AppearanceLabel" />
      </ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ComboBox x:Name="AppearanceCombo"
                  Width="240"
                  AutomationProperties.LabeledBy="{Binding #AppearanceLabel}"
                  SelectionChanged="OnAppearanceChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="FontRow" IconSource="Font">
      <ui:FASettingsExpander.Header>
        <TextBlock x:Name="FontLabel" />
      </ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ComboBox x:Name="FontCombo"
                  Width="240"
                  MaxDropDownHeight="320"
                  IsTextSearchEnabled="True"
                  AutomationProperties.LabeledBy="{Binding #FontLabel}"
                  SelectionChanged="OnFontChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="ColumnCountRow" IconSource="Bullets">
      <ui:FASettingsExpander.Header>
        <TextBlock x:Name="ColumnCountLabel" />
      </ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <NumericUpDown x:Name="ColumnCountInput"
                       Width="120"
                       Minimum="1"
                       Maximum="30"
                       Increment="1"
                       FormatString="0"
                       AutomationProperties.LabeledBy="{Binding #ColumnCountLabel}"
                       ValueChanged="OnColumnCountChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>
  </StackPanel>
</UserControl>
