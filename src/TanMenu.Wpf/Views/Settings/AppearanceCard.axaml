<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.AppearanceCard">
  <StackPanel Spacing="12">
    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Globe" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="LanguageLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="LanguageDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ComboBox x:Name="LanguageCombo"
                  Grid.Column="2"
                  Classes="hero-field"
                  Width="240"
                  VerticalAlignment="Center"
                  AutomationProperties.LabeledBy="{Binding #LanguageLabel}"
                  SelectionChanged="OnLanguageChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="View" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="AppearanceLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="AppearanceDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ComboBox x:Name="AppearanceCombo"
                  Grid.Column="2"
                  Classes="hero-field"
                  Width="240"
                  VerticalAlignment="Center"
                  AutomationProperties.LabeledBy="{Binding #AppearanceLabel}"
                  SelectionChanged="OnAppearanceChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Font" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="FontLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="FontDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ComboBox x:Name="FontCombo"
                  Grid.Column="2"
                  Classes="hero-field"
                  Width="240"
                  MaxDropDownHeight="320"
                  IsTextSearchEnabled="True"
                  VerticalAlignment="Center"
                  AutomationProperties.LabeledBy="{Binding #FontLabel}"
                  SelectionChanged="OnFontChanged" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
