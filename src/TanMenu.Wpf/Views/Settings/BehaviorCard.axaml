<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.BehaviorCard">
  <StackPanel Spacing="12">
    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="BackToWindow" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="AutoCloseLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="AutoCloseDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ToggleSwitch x:Name="AutoCloseToggle" Grid.Column="2" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnAutoCloseChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Pin" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="TopMostLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="TopMostDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ToggleSwitch x:Name="TopMostToggle" Grid.Column="2" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnTopMostChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Highlight" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="IslandPreviewLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="IslandPreviewDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ToggleSwitch x:Name="IslandPreviewToggle" Grid.Column="2" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnIslandPreviewChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-group">
      <StackPanel>
        <Grid Margin="16,12" ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
          <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Volume" FontSize="16" /></Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock x:Name="ButtonSoundsLabel" Classes="hero-setting-label" />
            <TextBlock x:Name="ButtonSoundsDescription" Classes="hero-setting-description" />
          </StackPanel>
        </Grid>
        <Border Classes="hero-setting-subrow">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock x:Name="HoverSoundLabel" Classes="hero-setting-label" />
              <TextBlock x:Name="HoverSoundDescription" Classes="hero-setting-description" />
            </StackPanel>
            <ToggleSwitch x:Name="HoverSoundToggle" Grid.Column="1" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnHoverSoundChanged" />
          </Grid>
        </Border>
        <Border Classes="hero-setting-subrow">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock x:Name="ClickSoundLabel" Classes="hero-setting-label" />
              <TextBlock x:Name="ClickSoundDescription" Classes="hero-setting-description" />
            </StackPanel>
            <ToggleSwitch x:Name="ClickSoundToggle" Grid.Column="1" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnClickSoundChanged" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Play" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="AutoStartLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="AutoStartDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="2" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnAutoStartChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Pin" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="PinTaskbarLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="PinTaskbarDescription" Classes="hero-setting-description" />
        </StackPanel>
        <Button x:Name="PinTaskbarBtn" Grid.Column="2" Classes="hero-button" VerticalAlignment="Center" Click="OnPinTaskbarClick" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Keyboard" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="HotkeyEnabledLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="HotkeyEnabledDescription" Classes="hero-setting-description" />
        </StackPanel>
        <ToggleSwitch x:Name="HotkeyEnabledToggle" Grid.Column="2" Classes="hero-switch" VerticalAlignment="Center" IsCheckedChanged="OnHotkeyEnabledChanged" />
      </Grid>
    </Border>

    <Border Classes="hero-setting-card">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
        <Border Classes="hero-setting-icon"><ui:FASymbolIcon Symbol="Keyboard" FontSize="16" /></Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="HotkeyLabel" Classes="hero-setting-label" />
          <TextBlock x:Name="HotkeyDescription" Classes="hero-setting-description" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBox x:Name="HotkeyBox"
                   Classes="hero-field"
                   Width="180"
                   IsReadOnly="True"
                   AutomationProperties.LabeledBy="{Binding #HotkeyLabel}" />
          <Button x:Name="HotkeyClearBtn" Classes="hero-button" Click="OnHotkeyClearClick" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
