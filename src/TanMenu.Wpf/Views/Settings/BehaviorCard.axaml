<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             HorizontalContentAlignment="Stretch"
             x:Class="TanMenu.Wpf.Views.Settings.BehaviorCard">
  <StackPanel Spacing="4">
    <ui:FASettingsExpander x:Name="AutoCloseRow" IconSource="BackToWindow">
      <ui:FASettingsExpander.Header><TextBlock x:Name="AutoCloseLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch x:Name="AutoCloseToggle" IsCheckedChanged="OnAutoCloseChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="TopMostRow" IconSource="Pin">
      <ui:FASettingsExpander.Header><TextBlock x:Name="TopMostLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch x:Name="TopMostToggle" IsCheckedChanged="OnTopMostChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="ButtonSoundsRow" IconSource="Volume" IsExpanded="True">
      <ui:FASettingsExpander.Header><TextBlock x:Name="ButtonSoundsLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Items>
        <ui:FASettingsExpanderItem x:Name="HoverSoundItem">
          <ui:FASettingsExpanderItem.Content><TextBlock x:Name="HoverSoundLabel" /></ui:FASettingsExpanderItem.Content>
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch x:Name="HoverSoundToggle" IsCheckedChanged="OnHoverSoundChanged" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>

        <ui:FASettingsExpanderItem x:Name="ClickSoundItem">
          <ui:FASettingsExpanderItem.Content><TextBlock x:Name="ClickSoundLabel" /></ui:FASettingsExpanderItem.Content>
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch x:Name="ClickSoundToggle" IsCheckedChanged="OnClickSoundChanged" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander.Items>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="AutoStartRow" IconSource="Play">
      <ui:FASettingsExpander.Header><TextBlock x:Name="AutoStartLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch x:Name="AutoStartToggle" IsCheckedChanged="OnAutoStartChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="PinTaskbarRow" IconSource="Pin">
      <ui:FASettingsExpander.Header><TextBlock x:Name="PinTaskbarLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <Button x:Name="PinTaskbarBtn" Click="OnPinTaskbarClick" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="HotkeyEnabledRow" IconSource="Keyboard">
      <ui:FASettingsExpander.Header><TextBlock x:Name="HotkeyEnabledLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch x:Name="HotkeyEnabledToggle" IsCheckedChanged="OnHotkeyEnabledChanged" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander x:Name="HotkeyRow" IconSource="Keyboard">
      <ui:FASettingsExpander.Header><TextBlock x:Name="HotkeyLabel" /></ui:FASettingsExpander.Header>
      <ui:FASettingsExpander.Footer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="HotkeyBox"
                   Width="180"
                   IsReadOnly="True"
                   AutomationProperties.LabeledBy="{Binding #HotkeyLabel}" />
          <Button x:Name="HotkeyClearBtn" Click="OnHotkeyClearClick" />
        </StackPanel>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>
  </StackPanel>
</UserControl>
