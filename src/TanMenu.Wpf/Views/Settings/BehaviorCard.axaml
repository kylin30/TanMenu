<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TanMenu.Wpf.Views.Settings.BehaviorCard">
  <!-- Six Windows 11 Settings-style rows: an icon, a title + secondary line, and the control
       trailing — same Grid(Auto,*,Auto) shape AppearanceCard established (see its code-behind for the
       full ReloadFromConfig contract every settings card group follows). Two rows (固定到任务栏, 热键)
       carry a control that needs more room than the trailing column offers, so their status/help line
       sits BELOW the row instead of in a second Grid column, indented to align under the title.

       OnContent/OffContent are blanked on every ToggleSwitch: Avalonia's default is the untranslated
       English "On"/"Off", which would sit right next to a Chinese row label whenever AppLanguage is
       zh-Hans. -->
  <StackPanel>
    <TextBlock x:Name="GroupHead" Classes="tm-group-head" />

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xED1A;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="AutoCloseTitle" Classes="tm-card-title" />
          <TextBlock x:Name="AutoCloseSub" Classes="tm-card-sub" />
        </StackPanel>
        <ToggleSwitch Grid.Column="2" x:Name="AutoCloseToggle" OnContent="" OffContent=""
                      VerticalAlignment="Center" IsCheckedChanged="OnAutoCloseChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE718;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="TopMostTitle" Classes="tm-card-title" />
          <TextBlock x:Name="TopMostSub" Classes="tm-card-sub" />
        </StackPanel>
        <ToggleSwitch Grid.Column="2" x:Name="TopMostToggle" OnContent="" OffContent=""
                      VerticalAlignment="Center" IsCheckedChanged="OnTopMostChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE7E8;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="AutoStartTitle" Classes="tm-card-title" />
          <TextBlock x:Name="AutoStartSub" Classes="tm-card-sub" />
        </StackPanel>
        <ToggleSwitch Grid.Column="2" x:Name="AutoStartToggle" OnContent="" OffContent=""
                      VerticalAlignment="Center" IsCheckedChanged="OnAutoStartChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE840;" Margin="0,0,14,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="PinTaskbarTitle" Classes="tm-card-title"
                     VerticalAlignment="Center" Margin="0,0,12,0" />
          <!-- The only button on this row, and — while there is still something useful for it to do
               (not yet pinned, or pinning needs a manual fallback) — an affirmative, forward-moving one,
               so it gets the accent treatment (see TmAccentButton's own comment in Launcher.axaml for
               the criteria applied to every settings-card button). Once already pinned there is no
               affirmative action left to offer, only a completed state to report, so Theme and Content
               are SWAPPED at run time by ApplyTaskbarPinState (code-behind) — Round 3, Task 3 (user
               item 8): a disabled TmAccentButton still painted a dimmed BLUE swatch (its own ^:disabled
               rule only lowers Opacity, it never repaints Background off AccentDefaultBrush), which
               still read as a live call to action, just quieter. Switching to the plain, neutral
               TmButton once pinned is what actually reads as "done", not "click me, but dimmer".

               Theme is nevertheless given a STATIC DEFAULT here, and that default is the NEUTRAL
               TmButton rather than the accent one. Round 3 residual review: without it, this Button had
               no Theme and no Classes at all, so "ApplyTaskbarPinState has not run yet" and "its
               FindResource lookup failed and it deliberately assigned nothing" rendered identically —
               as stock Fluent — and BOTH of those are reachable on the FIRST-EVER 设置 open of a
               process: SettingsPage's own constructor calls ReloadFromConfig (hence
               ApplyTaskbarPinState) while the whole card tree is still detached from the logical tree,
               where FindResource cannot reach Application.Styles at all, and the correcting value only
               arrives when the async COM pin query started from OnAttachedToVisualTree returns. The
               default makes that pre-query frame a neutral, disabled-looking button (the query disables
               it synchronously on attach, before anything paints) — which is exactly right for the
               already-pinned machine user item 8 is about, and merely understated for a not-yet-pinned
               one, corrected to accent a moment later. Defaulting to TmAccentButton instead would paint
               precisely the flagged "disabled accent-blue swatch" on that frame for every pinned user. -->
          <Button Grid.Column="2" x:Name="PinTaskbarBtn" Theme="{StaticResource TmButton}"
                  Click="OnPinTaskbarClick" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="PinTaskbarStatusText" Classes="tm-card-sub" TextWrapping="Wrap"
                   Margin="30,8,0,0" />
      </StackPanel>
    </Border>

    <Border Classes="tm-card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE765;" Margin="0,0,14,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="HotkeyEnabledTitle" Classes="tm-card-title" />
          <TextBlock x:Name="HotkeyEnabledSub" Classes="tm-card-sub" />
        </StackPanel>
        <ToggleSwitch Grid.Column="2" x:Name="HotkeyEnabledToggle" OnContent="" OffContent=""
                      VerticalAlignment="Center" IsCheckedChanged="OnHotkeyEnabledChanged" />
      </Grid>
    </Border>

    <Border Classes="tm-card">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="tm-icon" Text="&#xE92E;" Margin="0,0,14,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="HotkeyTitle" Classes="tm-card-title"
                     VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <!-- Key capture is wired in code with a TUNNELING KeyDown handler (see the ctor): a
                 bubbling handler would run after the TextBox has already consumed the key. -->
            <TextBox x:Name="HotkeyBox" Width="160" IsReadOnly="True" VerticalContentAlignment="Center"
                     Padding="8,5" />
            <!-- Clearing a hotkey is a reset, not a forward-moving action, so it stays on the plain
                 TmButton rather than TmAccentButton even though it is the row's only button. -->
            <Button x:Name="HotkeyClearBtn" Theme="{StaticResource TmButton}"
                    Click="OnHotkeyClearClick" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="HotkeyHelpText" Classes="tm-card-sub" TextWrapping="Wrap" Margin="30,8,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
