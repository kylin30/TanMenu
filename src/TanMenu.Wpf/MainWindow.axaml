<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:vm="using:TanMenu.Wpf.ViewModels"
                 xmlns:views="using:TanMenu.Wpf.Views"
                 x:Class="TanMenu.Wpf.MainWindow"
                 Title="TanMenu"
                 Width="1100" Height="760"
                 MinWidth="640" MinHeight="520"
                 WindowStartupLocation="Manual"
                 ShowInTaskbar="False"
                 Icon="/wwwroot/app.ico">

  <Grid RowDefinitions="48,*">
    <Grid x:Name="TitleBarHost"
          Height="48"
          ColumnDefinitions="Auto,Auto,*,138"
          Background="Transparent"
          WindowDecorationProperties.ElementRole="TitleBar">
      <Image Grid.Column="0"
             Width="16" Height="16"
             Margin="12,0,8,0"
             Source="/wwwroot/app-tile.png"
             Stretch="Uniform"
             IsHitTestVisible="False" />
      <TextBlock Grid.Column="1"
                 Text="TanMenu"
                 FontSize="12"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False" />

      <TextBox x:Name="SearchBox"
               x:DataType="vm:LauncherViewModel"
               Grid.Column="2"
               Classes="clearButton"
               Width="320"
               Height="32"
               MinHeight="0"
               Margin="0,8"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               WindowDecorationProperties.ElementRole="User"
               AutomationProperties.Name="{Binding SearchPlaceholderText}"
               PlaceholderText="{Binding SearchPlaceholderText}"
               Text="{Binding Filter, Mode=TwoWay}"
               KeyDown="OnSearchKeyDown">
        <TextBox.InnerLeftContent>
          <ui:FASymbolIcon Symbol="Find"
                           FontSize="14"
                           Margin="8,0,0,0" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Grid>

    <ui:FANavigationView x:Name="AppNavigation"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         OpenPaneLength="220"
                         CompactPaneLength="48"
                         IsPaneOpen="False"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="1440"
                         AlwaysShowHeader="False"
                         IsSettingsVisible="False"
                         IsBackButtonVisible="False"
                         IsPaneToggleButtonVisible="False"
                         ItemInvoked="OnNavigationItemInvoked"
                         SelectionChanged="OnNavigationSelectionChanged">
      <ui:FANavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
      </ui:FANavigationView.Resources>
      <ui:FANavigationView.MenuItems>
        <ui:FANavigationViewItem x:Name="TogglePaneNavItem"
                                 Tag="toggle-pane"
                                 SelectsOnInvoked="False">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="GlobalNavigationButton" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem x:Name="LauncherNavItem"
                                 Tag="launcher"
                                 IconSource="Home" />
        <ui:FANavigationViewItem x:Name="OpenRootNavItem"
                                 Tag="open-root"
                                 SelectsOnInvoked="False">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="OpenFolder" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem x:Name="RefreshNavItem"
                                 Tag="refresh"
                                 SelectsOnInvoked="False">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="Refresh" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.MenuItems>
      <ui:FANavigationView.FooterMenuItems>
        <ui:FANavigationViewItem x:Name="SettingsNavItem"
                                 Tag="settings">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="Setting" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem x:Name="ExitNavItem" Tag="exit">
          <ui:FANavigationViewItem.IconSource>
            <ui:FAFontIconSource Glyph="&#xE7E8;"
                                 FontFamily="Segoe Fluent Icons"
                                 FontSize="16" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.FooterMenuItems>

      <Grid>
        <Grid x:Name="LauncherPage">
          <views:AppPage x:Name="LauncherContent" />
        </Grid>

        <views:SettingsPage x:Name="SettingsContent" IsVisible="False" />
      </Grid>
    </ui:FANavigationView>
  </Grid>
</wnd:FAAppWindow>
