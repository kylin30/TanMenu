<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:vm="using:TanMenu.Wpf.ViewModels"
                 xmlns:views="using:TanMenu.Wpf.Views"
                 x:Class="TanMenu.Wpf.MainWindow"
                 Title="TanMenu"
                 Width="1180" Height="760"
                 MinWidth="840" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ShowInTaskbar="False"
                 Icon="/wwwroot/app.ico">

  <Grid ColumnDefinitions="64,*" Background="#F5F5F5">
    <Border Grid.Column="0" Classes="hero-sidebar-chrome">
      <Grid RowDefinitions="60,*">
        <Border Height="60"
                ToolTip.Tip="TanMenu"
                WindowDecorationProperties.ElementRole="TitleBar">
          <Image Width="22" Height="22"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Source="/wwwroot/app-tile.png"
                 Stretch="Uniform"
                 IsHitTestVisible="False" />
        </Border>

        <Border x:Name="SidebarPanel"
                Grid.Row="1"
                Classes="hero-sidebar-panel">
          <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <Button x:Name="LauncherNavButton"
                      Classes="hero-button hero-sidebar-item is-active"
                      Click="OnLauncherNavClick">
                <ui:FASymbolIcon Symbol="Home" FontSize="17" />
              </Button>

              <Button x:Name="SettingsNavButton"
                      Classes="hero-button hero-sidebar-item"
                      Click="OnSettingsNavClick">
                <ui:FASymbolIcon Symbol="Setting" FontSize="17" />
              </Button>
            </StackPanel>

            <Button x:Name="ExitNavButton"
                    Grid.Row="1"
                    Classes="hero-button hero-sidebar-item"
                    Click="OnExitClick">
              <TextBlock Text="&#xE7E8;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="17"
                         Width="17"
                         TextAlignment="Center" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="60,*">
      <Grid x:Name="TitleBarHost"
            Height="60"
            ColumnDefinitions="*,138"
            Background="#F5F5F5"
            Panel.ZIndex="1"
            WindowDecorationProperties.ElementRole="TitleBar">
        <StackPanel x:Name="LauncherTitleCommands"
                    Grid.Column="0"
                    Margin="16,12,0,12"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Left"
                    WindowDecorationProperties.ElementRole="User">
          <Border x:Name="SearchShell"
                  Classes="hero-search-shell"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  WindowDecorationProperties.ElementRole="User">
            <TextBox x:Name="SearchBox"
                     x:DataType="vm:LauncherViewModel"
                     Classes="clearButton hero-search-input"
                     AutomationProperties.Name="{Binding SearchPlaceholderText}"
                     PlaceholderText="{Binding SearchPlaceholderText}"
                     Text="{Binding Filter, Mode=TwoWay}"
                     WindowDecorationProperties.ElementRole="User"
                     KeyDown="OnSearchKeyDown">
              <TextBox.InnerLeftContent>
                <ui:FASymbolIcon Symbol="Find"
                                 FontSize="14"
                                 Margin="8,0,0,0" />
              </TextBox.InnerLeftContent>
            </TextBox>
          </Border>

          <Button x:Name="OpenRootNavButton"
                  Classes="hero-button hero-icon-button hero-title-command"
                  VerticalAlignment="Center"
                  Click="OnOpenRootClick">
            <ui:FASymbolIcon Symbol="OpenFolder" FontSize="16" />
          </Button>

          <Button x:Name="RefreshNavButton"
                  Classes="hero-button hero-icon-button hero-title-command"
                  VerticalAlignment="Center"
                  Click="OnRefreshClick">
            <ui:FASymbolIcon Symbol="Refresh" FontSize="16" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="ContentHost" Grid.Row="1">
        <Grid>
          <Grid x:Name="LauncherPage">
            <views:AppPage x:Name="LauncherContent" />
          </Grid>
          <views:SettingsPage x:Name="SettingsContent" IsVisible="False" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</wnd:FAAppWindow>
