<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:vm="using:TanMenu.Wpf.ViewModels"
                 xmlns:views="using:TanMenu.Wpf.Views"
                 x:Class="TanMenu.Wpf.MainWindow"
                 Title="TanMenu"
                 Width="1100" Height="760"
                 MinWidth="640" MinHeight="520"
                 WindowStartupLocation="Manual"
                 Icon="/wwwroot/app.ico">

  <Grid RowDefinitions="32,*">
    <Grid x:Name="TitleBarHost"
          Height="32"
          ColumnDefinitions="Auto,Auto,*"
          Background="Transparent"
          WindowDecorationProperties.ElementRole="TitleBar">
      <Image Grid.Column="0"
             Width="16" Height="16"
             Margin="12,0,8,0"
             Source="/wwwroot/app-tile.png"
             Stretch="Uniform"
             IsHitTestVisible="False" />
      <TextBlock Grid.Column="1"
                 Text="TanMenu"
                 FontSize="12"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False" />
    </Grid>

    <ui:FANavigationView x:Name="AppNavigation"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         OpenPaneLength="220"
                         CompactPaneLength="48"
                         IsPaneOpen="False"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="1440"
                         AlwaysShowHeader="False"
                         IsSettingsVisible="False"
                         IsBackButtonVisible="False"
                         SelectionChanged="OnNavigationSelectionChanged">
      <ui:FANavigationView.MenuItems>
        <ui:FANavigationViewItem x:Name="LauncherNavItem"
                                 Tag="launcher"
                                 IconSource="Home" />
      </ui:FANavigationView.MenuItems>
      <ui:FANavigationView.FooterMenuItems>
        <ui:FANavigationViewItem x:Name="SettingsNavItem"
                                 Tag="settings">
          <ui:FANavigationViewItem.IconSource>
            <ui:FASymbolIconSource Symbol="Setting" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
        <ui:FANavigationViewItem x:Name="ExitNavItem" Tag="exit">
          <ui:FANavigationViewItem.IconSource>
            <ui:FAFontIconSource Glyph="&#xE7E8;"
                                 FontFamily="Segoe Fluent Icons"
                                 FontSize="16" />
          </ui:FANavigationViewItem.IconSource>
        </ui:FANavigationViewItem>
      </ui:FANavigationView.FooterMenuItems>

      <Grid>
        <Grid x:Name="LauncherPage" RowDefinitions="Auto,*">
          <Grid Grid.Row="0"
                Margin="24,8,24,8"
                ColumnDefinitions="Auto,Auto,Auto,*">

            <TextBox x:Name="SearchBox"
                     x:DataType="vm:LauncherViewModel"
                     Grid.Column="0"
                     Classes="clearButton"
                     Width="320"
                     MinHeight="32"
                     Margin="0,2,8,2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding SearchPlaceholderText}"
                     PlaceholderText="{Binding SearchPlaceholderText}"
                     Text="{Binding Filter, Mode=TwoWay}"
                     KeyDown="OnSearchKeyDown">
              <TextBox.InnerLeftContent>
                <ui:FASymbolIcon Symbol="Find"
                                 FontSize="14"
                                 Margin="8,0,0,0" />
              </TextBox.InnerLeftContent>
            </TextBox>

            <Button x:Name="MenuOpenRoot"
                    Grid.Column="1"
                    Margin="0,2,8,2"
                    Click="OnOpenRootClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="OpenFolder" FontSize="16" />
                <TextBlock x:Name="MenuOpenRootText" />
              </StackPanel>
            </Button>

            <Button x:Name="MenuRefresh"
                    Grid.Column="2"
                    Margin="0,2,0,2"
                    Click="OnRefreshClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Refresh" FontSize="16" />
                <TextBlock x:Name="MenuRefreshText" />
              </StackPanel>
            </Button>
          </Grid>

          <views:AppPage x:Name="LauncherContent" Grid.Row="1" />
        </Grid>

        <views:SettingsPage x:Name="SettingsContent" IsVisible="False" />
      </Grid>
    </ui:FANavigationView>
  </Grid>
</wnd:FAAppWindow>
