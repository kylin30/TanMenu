<!--
  The settings window is deliberately a PLAIN Fluent-themed window: Themes/Fluent2/Launcher.axaml
  styles the LAUNCHER only. A settings dialog is a place where users expect the platform's own
  controls (native focus rings, scrollbars, IME candidate placement, high-contrast), and
  reimplementing all of that to gain a slightly different grey would not break even.

  It still reads as Fluent 2 because Themes/Fluent2/Tokens.axaml overrides the three Avalonia theme
  keys that measurably propagate — ControlCornerRadius, OverlayCornerRadius and
  ContentControlThemeFontFamily — so these standard controls get Fluent 2's 4 px radius and the
  system UI face without a single control template being rewritten.

  There are no bindings here on purpose. Every string is localized imperatively from code-behind
  (AppLanguage has no change notification and must re-label a LIVE window when the language dropdown
  changes), so the hardcoded Chinese below is only design-time filler — ApplyStaticText() overwrites
  all of it during construction.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TanMenu.Wpf.SettingsWindow"
        Title="TanMenu 设置"
        Width="540" Height="540" MinWidth="480" MinHeight="460"
        WindowStartupLocation="Manual" CanResize="True"
        FontSize="13" ShowInTaskbar="True"
        TransparencyLevelHint="Mica"
        Background="Transparent"><!--
        Mica, per the Windows 11 material guidance: Mica backs long-lived APP windows, acrylic backs
        transient light-dismiss surfaces. This settings dialog stays open while the user works in it,
        so it takes Mica; the launcher, which hides the moment it loses focus, takes acrylic.

        Background must be Transparent for the backdrop to show through. When the platform does not
        grant Mica (Windows 10, transparency disabled, remote desktop) the code-behind paints
        SurfaceBaseBrush instead — Avalonia's own Fluent 1 dark palette would otherwise leave a
        dialog pure #000000, harsher than Fluent 2's #202020 and a visible mismatch next to the
        launcher. Everything else — controls, focus, scroll, IME — stays platform-default on purpose. -->

  <Window.Styles>
    <!-- Fluent's TabItem theme hardcodes a 24px header, which does not inherit the window's 13px and
         makes the tab strip tower over the settings it labels. The WPF window was a compact dialog;
         keep that proportion. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <!-- HorizontalContentAlignment is explicit because Avalonia's ContentControl defaults it to
           Left, not Center as WPF does — without it these fixed-width buttons render their labels
           jammed against the left edge. (MessageBoxWindow sets the same thing in code-behind.) -->
      <Button x:Name="OkBtn" Content="确定" Click="Ok_Click" Width="80" Padding="0,5"
              HorizontalContentAlignment="Center"/>
      <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" Width="80" Padding="0,5"
              HorizontalContentAlignment="Center"/>
      <!-- Starts disabled: 应用 is enabled exactly while there are unapplied staged edits. -->
      <Button x:Name="ApplyBtn" Content="应用" Click="Apply_Click" Width="80" Padding="0,5"
              HorizontalContentAlignment="Center" IsEnabled="False"/>
    </StackPanel>

    <TabControl>

      <TabItem x:Name="AppearanceTab" Header="外观">
        <StackPanel Margin="14">
          <StackPanel Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
            <TextBlock x:Name="LanguageLabel" Text="语言：" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="LanguageCombo" Width="220" SelectionChanged="Language_Changed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
            <!-- Replaces the old single-entry 主题 dropdown, which could never change anything.
                 There is one design language and it renders in two variants, so the choice users
                 actually have is light/dark. -->
            <TextBlock x:Name="AppearanceLabel" Text="外观：" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="AppearanceCombo" Width="220" SelectionChanged="Appearance_Changed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
            <TextBlock x:Name="FontLabel" Text="字体：" Width="90" VerticalAlignment="Center"/>
            <!-- IsTextSearchEnabled restores the WPF list's type-ahead: with hundreds of installed
                 families, typing the first letters is how the list is actually navigated. The rows are
                 ComboBoxItems whose Content is the display name, so no TextSearch.TextPath is needed,
                 and the disabled group-header rows are skipped because they are not selectable. -->
            <ComboBox x:Name="FontCombo" Width="220" MaxDropDownHeight="320"
                      IsTextSearchEnabled="True"
                      SelectionChanged="Font_SelectionChanged"/>
          </StackPanel>
          <!-- 每列按钮数 is gone: tiles wrap to the available width now, so a fixed column count
               shapes nothing. The stored value is still round-tripped for older configs. -->
          <StackPanel Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
            <TextBlock x:Name="ButtonSizeLabel" Text="按钮大小：" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="SizeCombo" Width="220" SelectionChanged="Size_Changed"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem x:Name="BehaviorTab" Header="行为">
        <StackPanel Margin="14">
          <CheckBox x:Name="AutoCloseCb" Content="失焦自动隐藏" Margin="0,7" Click="Opt_Changed"/>
          <CheckBox x:Name="TopMostCb" Content="窗口置顶" Margin="0,7" Click="Opt_Changed"/>
          <CheckBox x:Name="AutoStartCb" Content="开机自启" Margin="0,7" Click="AutoStart_Changed"/>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="PinTaskbarBtn" Content="固定到任务栏" Click="PinTaskbar_Click" Padding="14,5"/>
          </StackPanel>
          <TextBlock x:Name="PinTaskbarStatusText" Text="固定后，点击任务栏图标显示主界面；失去焦点自动隐藏。"
                     Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>

          <Separator Margin="0,10"/>
          <CheckBox x:Name="HotkeyEnabledCb" Content="启用全局热键（呼出 / 隐藏）" Margin="0,4" Click="Hotkey_Changed"/>
          <StackPanel Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
            <TextBlock x:Name="HotkeyLabel" Text="热键：" Width="50" VerticalAlignment="Center"/>
            <!-- Key capture is wired in code with a TUNNELING KeyDown handler (see the ctor): a bubbling
                 handler would run after the TextBox has already consumed the key. -->
            <TextBox x:Name="HotkeyBox" Width="190" IsReadOnly="True" VerticalContentAlignment="Center"
                     Padding="4,3"/>
            <Button x:Name="HotkeyClearBtn" Content="清除" Click="HotkeyClear_Click" Padding="12,3" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="HotkeyHelpText" Text="默认无热键。点击上方输入框并按下组合键来自定义。"
                     Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </TabItem>

      <TabItem x:Name="FoldersTab" Header="文件夹">
        <StackPanel Margin="14">
          <TextBlock x:Name="MainFolderTitle" Text="主文件夹" FontWeight="Bold"/>
          <TextBlock x:Name="MainFolderHelpText" Text="显示该文件夹下的子文件夹。"
                     Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,4"/>
          <TextBox x:Name="RootBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,4"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,18">
            <Button x:Name="OpenRootBtn" Content="打开" Click="OpenRoot_Click" Width="76" Padding="0,4"/>
            <Button x:Name="PickRootBtn" Content="选择…" Click="PickRoot_Click" Width="76" Padding="0,4"/>
          </StackPanel>

          <DockPanel>
            <TextBlock x:Name="DataInfoText" DockPanel.Dock="Right" Foreground="Gray"
                       VerticalAlignment="Center" FontSize="12"/>
            <TextBlock x:Name="DataFolderTitle" Text="数据文件夹" FontWeight="Bold"/>
          </DockPanel>
          <TextBlock x:Name="DataHelpText" Text="配置与缓存的存放位置。"
                     Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,4"/>
          <TextBox x:Name="DataBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,4"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button x:Name="OpenDataBtn" Content="打开" Click="OpenData_Click" Width="76" Padding="0,4"/>
            <Button x:Name="ChangeDataBtn" Content="更改…" Click="ChangeData_Click" Width="76" Padding="0,4"/>
            <Button x:Name="ResetDataBtn" Content="重置为默认" Click="ResetData_Click" Padding="12,4"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="ClearCacheBtn" Content="清理缓存" Click="ClearCache_Click" Padding="12,4"/>
            <Button x:Name="BackupBtn" Content="备份…" Click="BackupConfig_Click" Padding="12,4"/>
            <Button x:Name="RestoreBtn" Content="恢复…" Click="RestoreConfig_Click" Padding="12,4"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem x:Name="ToolsTab" Header="常用工具">
        <StackPanel Margin="14">
          <CheckBox x:Name="ShowToolsCb" Content="显示“常用工具”分类" Margin="0,2,0,6" Click="ShowTools_Changed"/>
          <TextBlock x:Name="ToolsHintText" Text="勾选要在该分类中显示的工具：" Foreground="Gray"
                     TextWrapping="Wrap" Margin="0,0,0,4"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
            <StackPanel x:Name="ToolsPanel"/>
          </ScrollViewer>
        </StackPanel>
      </TabItem>

      <TabItem x:Name="UpdatesTab" Header="更新">
        <StackPanel Margin="14">
          <TextBlock x:Name="CurrentVersionText" Text="当前版本：" FontWeight="Bold" Margin="0,6,0,8"/>
          <TextBlock x:Name="UpdateHelpText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="100"
                       IsVisible="False" Margin="0,0,0,14"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CheckUpdateBtn" Content="检查更新" Click="CheckUpdate_Click" Padding="14,5"/>
            <Button x:Name="UpdateActionBtn" Content="下载更新" Click="UpdateAction_Click" Padding="14,5"
                    IsVisible="False"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
