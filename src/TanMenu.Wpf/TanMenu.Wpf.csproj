<Project Sdk="Microsoft.NET.Sdk">

  <!-- NOTE ON THE PROJECT NAME: this project no longer uses WPF (it is Avalonia + NativeAOT), but the
       assembly is deliberately still called TanMenu.Wpf. The produced TanMenu.Wpf.exe filename is part
       of the shipped identity: Velopack updates from 0.9.x, the MSIX Store package's Executable entry,
       the per-user Run-key autostart value (RegistryAutoStartService compares the stored path against
       Environment.ProcessPath), and the pinned taskbar shortcut all reference it. Renaming would break
       autostart and the taskbar pin for every existing user for no functional gain. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 is required for the Windows.UI.Shell.TaskbarManager projection used by
         TaskbarPinService; it is not a WPF/WinForms dependency. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TanMenu.Wpf</RootNamespace>
    <AssemblyName>TanMenu.Wpf</AssemblyName>
    <StartupObject>TanMenu.Wpf.Program</StartupObject>
    <ApplicationIcon>wwwroot\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>TanMenu</Product>
    <Company>TanSoft</Company>
    <Authors>TanSoft</Authors>
    <Copyright>© TanSoft. All rights reserved.</Copyright>
    <AssemblyTitle>TanMenu</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NativeAOT. BuiltInComInteropSupport must be off: the runtime's classic COM interop emits its
         stubs at run time and cannot work here (IL3052). All COM goes through the source-generated
         wrappers in TanMenu.Core.Interop. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Do NOT enable InvariantGlobalization: the launcher sorts groups and fonts with
         StringComparer.CurrentCultureIgnoreCase, which must keep collating Chinese correctly. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Report every trim/AOT warning individually instead of one rolled-up warning per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Reflection-based bindings are stripped by the trimmer; compiled bindings are also faster. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <!-- No Avalonia.Diagnostics: it has not been published for the 12.x line (11.3.18 is its latest),
         and it is a debug-only DevTools overlay, not something the app needs. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="$(VelopackVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TanMenu.Core\TanMenu.Core.csproj" />
  </ItemGroup>

  <!-- Round 8, Task 1: SettingsDraft and SettingsCommit are internal (nothing outside the settings
       surface may construct or commit a draft), and they are also the one piece of that surface that is
       testable without a window. The test project already references this assembly for the source tests
       under tests/…/Themes; this lets SettingsDraftTests exercise the real types instead of a copy. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TanMenu.Core.Tests" />
  </ItemGroup>

  <!-- Alibaba PuHuiTi Regular, Medium, SemiBold and Bold are embedded inside the executable so the UI does not depend
       on fonts installed on the customer machine. Services/AppFonts registers this collection before
       any text is measured. -->
  <ItemGroup>
    <AvaloniaResource Include="wwwroot\fonts\AlibabaPuHuiTi2-Regular.ttf" />
    <AvaloniaResource Include="wwwroot\fonts\AlibabaPuHuiTi2-Medium.ttf" />
    <AvaloniaResource Include="wwwroot\fonts\AlibabaPuHuiTi2-SemiBold.ttf" />
    <AvaloniaResource Include="wwwroot\fonts\AlibabaPuHuiTi2-Bold.ttf" />
    <AvaloniaResource Include="wwwroot\app.ico" />
    <AvaloniaResource Include="wwwroot\app-tile.png" />
    <None Update="wwwroot\fonts\NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="FONT-NOTICE.txt" />
  </ItemGroup>

  <!-- The tray icon is handed to Win32/Velopack as a real file, and Velopack's own shortcut creation
       wants it on disk, so app.ico is ALSO copied next to the exe. -->
  <Target Name="CopyAppIconToOutput" AfterTargets="Build">
    <Copy SourceFiles="wwwroot\app.ico" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAppIconToPublish" AfterTargets="Publish">
    <Copy SourceFiles="wwwroot\app.ico" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- SoundService (TanMenu.Core) reads the wavs from <exe>\wwwroot\sounds at run time via
       System.Media.SoundPlayer, so they stay loose files. -->
  <ItemGroup>
    <TanMenuSounds Include="wwwroot\sounds\*.wav" />
  </ItemGroup>
  <Target Name="CopySoundsToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(TanMenuSounds)" DestinationFolder="$(OutDir)wwwroot\sounds" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopySoundsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(TanMenuSounds)" DestinationFolder="$(PublishDir)wwwroot\sounds" SkipUnchangedFiles="true" />
  </Target>

  <!-- Bundled icons for Store-app alias tools (e.g. mspaint.exe), whose 0-byte execution-alias stub
       has no embedded icon. MenuService reads these from <exe>\wwwroot\tool-icons at run time. -->
  <ItemGroup>
    <TanMenuToolIcons Include="wwwroot\tool-icons\*.png" />
  </ItemGroup>
  <Target Name="CopyToolIconsToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(TanMenuToolIcons)" DestinationFolder="$(OutDir)wwwroot\tool-icons" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyToolIconsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(TanMenuToolIcons)" DestinationFolder="$(PublishDir)wwwroot\tool-icons" SkipUnchangedFiles="true" />
  </Target>

</Project>
