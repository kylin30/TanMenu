<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TanMenu.Wpf.Island.IslandPreviewWindow"
        Title=""
        Width="320"
        Height="72"
        MinWidth="320"
        MaxWidth="320"
        MinHeight="72"
        MaxHeight="72"
        CanResize="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        WindowDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent">
  <Grid Background="Transparent">
    <Path x:Name="Shape"
          Fill="#18181B"
          Stroke="#28282C"
          StrokeThickness="1"
          StrokeJoin="Round"/>
    <Grid x:Name="Slots"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          IsHitTestVisible="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
        <Path x:Name="CpuIcon" Width="16" Height="16" Stretch="Uniform" Fill="#8E8E93"
              Data="M3,6 H5 V4 H7 V6 H9 V4 H11 V6 H13 V8 H11 V10 H13 V12 H11 V14 H9 V12 H7 V14 H5 V12 H3 V10 H5 V8 H3 Z M7,8 H9 V10 H7 Z"/>
        <TextBlock x:Name="CpuText" Text="—" FontSize="11" Foreground="#E4E4E7" MinWidth="36" TextAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
        <Border Width="18" Height="12" CornerRadius="2" BorderBrush="#8E8E93" BorderThickness="1" Padding="1" VerticalAlignment="Center">
          <Border x:Name="MemoryFill" Height="2" VerticalAlignment="Bottom" Background="#5EEAD4"/>
        </Border>
        <TextBlock x:Name="MemoryText" Text="—" FontSize="11" Foreground="#E4E4E7" MinWidth="36" TextAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Path x:Name="ReceiveIcon" Width="8" Height="12" Stretch="Uniform" Fill="#8E8E93" Data="M4,0 L4,8 L1,5 L4,11 L7,5 L4,8"/>
          <Path x:Name="SendIcon" Width="8" Height="12" Stretch="Uniform" Fill="#8E8E93" Data="M4,12 L4,4 L1,7 L4,1 L7,7 L4,4"/>
        </StackPanel>
        <TextBlock x:Name="NetworkText" Text="—" FontSize="10" Foreground="#E4E4E7" MinWidth="92" TextAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
