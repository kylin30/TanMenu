<?xml version="1.0" encoding="utf-8"?>
<!-- NativeAOT publish. The output is a single native TanMenu.Wpf.exe (plus its native .pdb, the
     Avalonia native libraries, and the loose runtime assets the app reads from disk) — no .NET
     runtime, no managed assemblies, no *.deps.json / *.runtimeconfig.json. The target machine needs
     nothing installed; there is no WebView2 requirement any more.

     PublishAot implies SelfContained, so it is not repeated here. PublishReadyToRun MUST NOT come
     back: it is mutually exclusive with PublishAot. PublishSingleFile is likewise meaningless for an
     AOT build (there is no bundle to extract).

     Expect this publish to take considerably longer than the old ReadyToRun one: ILC compiles the
     whole program in a single pass and then links it natively. Both packaging scripts invoke it, and
     both deliberately allow a restore (they pass no "no restore" switch) so the ILC runtime packs can
     be fetched on a clean runner. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <!-- Every packaging script and CI validation step hardcodes this location. -->
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
