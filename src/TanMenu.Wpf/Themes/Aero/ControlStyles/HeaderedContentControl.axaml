<!--
    Copyright (c) 2026 Splitwirez
    Licensed under the MIT License. See LICENSE-aero-theme-for-avalonia.txt in the Themes/Aero
    directory for the full text of the copyright notice and permission notice.
    Source: https://github.com/Splitwirez/aero-theme-for-avalonia at main = a705b7c0
            src/AeroAvalonia/ControlStyles/HeaderedContentControl.axaml
    Changes from upstream:
      1. RE-POINTED the ae xmlns from "using:AeroAvalonia" to
         "using:TanMenu.Wpf.Themes.Aero.Controls", which is where HeaderGapClipper.cs was vendored.
      2. DELETED upstream's commented-out MaxWidth binding on PART_HeaderPresenter (its own lines
         45-47). It is dead prose about a binding the author disabled, and this project deletes
         markup that does nothing rather than carrying it.
      3. DELETED the <Control x:Name="HeaderPresenterSizeHelper" /> that shared the header Panel with
         PART_HeaderPresenter (upstream's lines 30-34), for the SAME reason as change 2 and in the
         same act: the binding deleted there —
         MaxWidth="{Binding #HeaderPresenterSizeHelper.Bounds.Width, Mode=OneWay}" — was the helper's
         only reader anywhere. Nothing else upstream names it, nothing in this tree does (the name
         appears in no other .axaml and in no .cs, HeaderGapClipper.cs included), and its own name
         invites the opposite conclusion, so leaving it would have had all six settings group boxes
         instantiating and arranging an element nothing reads. It is a bare Control, whose
         MeasureOverride returns 0x0, and a Panel takes the largest of its children's desired sizes,
         so the header Panel was sized by the presenter with or without it. VERIFIED RATHER THAN
         ARGUED, on the published NativeAOT build at 150 % in both variants: every UIA rect on the
         设置 page is unmoved (外观's head 45x31 px at 3046,1334; SettingsScroll 2232x807 px; the
         three trailing controls 330 px wide), and the PrintWindow capture of the page — at the top
         and scrolled to the bottom — is pixel-identical below the glass caption band. The caption
         band itself (rows 0..44 of the capture) differs on EVERY pair of runs, the same binary
         included, because PrintWindow composites the DWM backdrop and the backdrop samples what is
         behind the window; that was measured too rather than assumed.
    Everything else is byte for byte upstream, line endings included.

    THE KEY IS "GroupBox", NOT {x:Type HeaderedContentControl}, and that is upstream's choice rather
    than ours: a HeaderedContentControl is the base class of TabItem, Expander's header host and
    several others, so the library never auto-applies this theme. It is opt-in through
    Theme="{StaticResource GroupBox}", and this app's five interactive settings groups plus 关于 are
    its only consumers (Views/Settings/*.axaml, Round 7 Task 9).

    WHAT THE CLIPPER IS FOR. A Windows 7 group box draws its label ON the outline, with the outline
    interrupted behind it. Bd is the outline; HeaderGapClipper takes PART_HeaderPresenter's arranged
    rect and clips Bd to everything outside it, which is what cuts the notch. Nothing else in the
    template does that, so removing the clipper would draw the label on top of an unbroken line.

    THE THREE METRICS BELOW ARE OVERRIDDEN BY US, in Themes/Shell/Launcher.axaml's
    HeaderedContentControl.tm-group-box rule, and this file is left stating upstream's: a Style in
    Application.Styles outranks a ControlTheme's own Setter in Avalonia, so the override is the
    documented mechanism rather than a fight. See that rule for the numbers and their citations.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ae="using:TanMenu.Wpf.Themes.Aero.Controls"
                    x:ClassModifier="Internal">
    <ControlTheme x:Key="GroupBox"
                TargetType="{x:Type HeaderedContentControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AeroGroupBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontSize" Value="{DynamicResource AeroFontSizeNormal}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <ae:HeaderGapClipper HeaderElement="{Binding #PART_HeaderPresenter, Mode=OneWay}"
                                        Grid.Row="0"
                                        Grid.RowSpan="2">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </ae:HeaderGapClipper>

                    <Panel Grid.Row="0"
                        Margin="7,0">
                        <ContentPresenter x:Name="PART_HeaderPresenter"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        HorizontalAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Padding="2,0"
                                         />
                    </Panel>

                    <ContentPresenter x:Name="PART_ContentPresenter"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Margin="0,-4,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Grid.Row="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Bd">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
