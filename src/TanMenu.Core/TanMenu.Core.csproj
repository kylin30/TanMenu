<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TanMenu.Core</RootNamespace>
    <AssemblyName>TanMenu.Core</AssemblyName>
    <!-- The shell interop marshals string-out parameters through char* (the COM source generator
         does not support StringBuilder). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep the trim/AOT analyzers on permanently: the app publishes with PublishAot, so a new
         reflection-based call here must fail the build rather than surface as a runtime error in a
         released binary. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TanMenu.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.0" />
  </ItemGroup>

</Project>
